---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import GalleryGrid from '../../components/GalleryGrid.astro';
import Pagination from '../../components/Pagination.astro';
import { shots } from '../../data/gallery';

// getStaticPaths is hoisted out of the component scope, so it cannot close over
// anything declared here — the page size is inlined deliberately.
export const getStaticPaths = (({ paginate }) => {
  return paginate(shots, { pageSize: 9 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const suffix = page.currentPage > 1 ? ` — page ${page.currentPage}` : '';
---

<Base
  title={`Gallery${suffix} — Run Baby Run Club`}
  description="Photos from Run Baby Run's weekly runs around Yerevan."
>
  <Nav current="gallery" />
  <main>
    <PageHeader
      eyebrow="Most weeks look like this"
      title="The gallery."
      tone="pink"
      meta={`Page ${page.currentPage} of ${page.lastPage} · showing ${page.data.length} of ${page.total}`}
    >
      <p>
        Every run ends the same way — someone shouts “photo!” and we all squint into it. {page.total} of them, so far.
      </p>
    </PageHeader>

    <section class="section gallery-page">
      <div class="wrap">
        <GalleryGrid shots={page.data} offset={page.start} />
        <Pagination page={page} />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .gallery-page {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
</style>
