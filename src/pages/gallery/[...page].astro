---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhotoWall from '../../components/PhotoWall.astro';
import Lightbox from '../../components/Lightbox.astro';
import Pagination from '../../components/Pagination.astro';
import { photos } from '../../data/library';

// getStaticPaths is hoisted out of the component scope, so it cannot close over
// anything declared here — the page size is inlined deliberately. Newest first,
// which means the top of the gallery is the last run.
export const getStaticPaths = (({ paginate }) => {
  const newest = [...photos].sort((a, b) => b.date.localeCompare(a.date) || a.id.localeCompare(b.id));
  return paginate(newest, { pageSize: 60 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const suffix = page.currentPage > 1 ? ` — page ${page.currentPage}` : '';
---

<Base
  title={`Gallery${suffix} — Run Baby Run Club`}
  description="Every photo from Run Baby Run's runs around Yerevan, by the day it was taken."
>
  <Nav current="gallery" />
  <main>
    <PageHeader
      eyebrow="Most weeks look like this"
      title="The gallery."
      tone="pink"
      meta={`Page ${page.currentPage} of ${page.lastPage} · showing ${page.data.length} of ${page.total}`}
    >
      <p>
        Every run ends the same way — someone shouts “photo!” and we all squint into
        it. {page.total} of them since February, by the day they were taken. Any date
        here takes you to that day in the <a href="/diary/">diary</a>.
      </p>
    </PageHeader>

    <section class="section gallery-page">
      <div class="wrap">
        <PhotoWall photos={page.data} />
        <Pagination page={page} />
      </div>
    </section>

    <Lightbox />
  </main>
  <Footer />
</Base>

<style>
  .gallery-page {
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
  }
</style>
