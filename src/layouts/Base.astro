---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../data/site';
import MiniPlayer from '../components/MiniPlayer.astro';
import { song } from '../data/song';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} Club — ${site.city}`,
  description = `A running club in ${site.city}. ${site.tagline} Tuesdays 22:00, Thursdays 07:45, Saturdays 06:30.`,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/logo.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f6f4" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Inter:wght@400;500;700&display=swap"
    />

    <!-- Client-side navigation, so the club song survives a page change. -->
    <ClientRouter />
  </head>
  <body>
    <slot />

    <!-- One audio element for the whole site. transition:persist keeps this
         exact node (and its playback position) across navigations. -->
    <audio
      id="rbr-audio"
      src={song.file}
      preload="none"
      transition:persist="rbr-audio"
    ></audio>

    <MiniPlayer transition:persist="rbr-mini" />
  </body>
</html>
