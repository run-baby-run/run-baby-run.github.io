---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { site } from '../data/site';
import MiniPlayer from '../components/MiniPlayer.astro';
import { playlist } from '../data/song';

interface Props {
  title?: string;
  description?: string;
  /** Keeps a page out of search results and the sitemap — preview pages only. */
  noindex?: boolean;
}

const {
  title = `${site.name} Club — ${site.city}`,
  description = `A running club in ${site.city}. ${site.tagline} Tuesdays 22:00, Thursdays 07:45, Saturdays 06:30.`,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/images/logo.jpg', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f7f6f4" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;700;800&family=Inter:wght@400;500;700&display=swap"
    />

    <!-- Client-side navigation, so the club song survives a page change. -->
    <ClientRouter />
  </head>
  <body>
    <!--
      A navigation progress bar.

      Not a page-load spinner: these pages are prerendered HTML and first paint
      is 724ms on 4G, so anything JavaScript drew would arrive after the content
      it was meant to cover. The gap is elsewhere. ClientRouter turns an in-site
      click into a fetch-and-swap, and a fetch gets none of the browser's own
      loading feedback — no tab spinner, no bar in the address bar. Measured on
      a throttled Slow 3G, a tap on Gallery leaves the screen completely
      unchanged for 1974ms. This is the only thing on the site that has to say
      "heard you".

      transition:persist so the bar is the same node either side of the swap.
    -->
    <div id="rbr-progress" class="progress" aria-hidden="true" transition:persist="rbr-progress">
      <span></span>
    </div>

    <slot />

    <!-- One audio element for the whole site. transition:persist keeps this
         exact node (and its playback position) across navigations. -->
    <audio
      id="rbr-audio"
      src={playlist[0].file}
      preload="none"
      transition:persist="rbr-audio"
    ></audio>

    <MiniPlayer transition:persist="rbr-mini" />

    <script is:inline>
      // is:inline and guarded: ClientRouter re-runs page scripts on every
      // navigation, and a listener added each time would stack up.
      (() => {
        if (window.__rbrProgress) return;
        window.__rbrProgress = true;

        // Below this, a bar would flash on and off and read as a glitch. Most
        // navigations on a decent connection finish inside it and show nothing
        // at all, which is the point.
        const SHOW_AFTER = 180;
        let timer;

        const bar = () => document.getElementById('rbr-progress');

        document.addEventListener('astro:before-preparation', () => {
          clearTimeout(timer);
          timer = setTimeout(() => {
            const el = bar();
            if (!el) return;
            // Rewind with transitions off, or the bar would ease backwards
            // from wherever the last navigation left it.
            const fill = el.firstElementChild;
            el.classList.remove('is-loading', 'is-done');
            fill.style.transition = 'none';
            fill.style.width = '0%';
            void el.offsetWidth;
            // Both inline values have to go, not just the transition: an
            // inline width of 0 outranks the class that does the crawling,
            // and the bar would sit at zero for the whole navigation.
            fill.style.transition = '';
            fill.style.width = '';
            el.classList.add('is-loading');
          }, SHOW_AFTER);
        });

        const finish = () => {
          clearTimeout(timer);
          const el = bar();
          if (!el || !el.classList.contains('is-loading')) return;
          el.classList.remove('is-loading');
          el.classList.add('is-done');
        };

        document.addEventListener('astro:page-load', finish);
        // A failed or cancelled navigation never reaches page-load, so the bar
        // would sit there crawling for ever.
        document.addEventListener('astro:before-swap', finish);
        window.addEventListener('pagehide', finish);
      })();
    </script>
  </body>
</html>
