---
/**
 * One of the street dogs that tags along on a run, drawn side-on to match the
 * club's flat, ink-outlined style.
 *
 * The whole performance is one 17s loop, shared with the pack in RunnersBand:
 * the dog trails the runners, pulls up at the pulpulak, drinks, then chases
 * after them. Its legs have to STOP while it drinks, which a short looping
 * gait cannot express — so the gait is generated here as explicit keyframes
 * across the full loop, holding still through the drinking window.
 */

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const ink = '#141414';
const coat = '#c9a273';
const coatDark = '#a8834f';

// --- choreography, as fractions of the shared loop -------------------------
const RUN1_END = 0.42; // arrives at the fountain
const DRINK_END = 0.68; // head comes back up
const STRIDES_1 = 9;
const STRIDES_2 = 8;
const SAMPLES_PER_STRIDE = 4;
const SWING = 32; // degrees fore/aft
const pct = (n: number) => `${(n * 100).toFixed(2)}%`;

/** Stops of {t, phase}: phase accumulates strides while running, holds while drinking. */
const stops: { t: number; phase: number }[] = [];
for (let i = 0; i <= STRIDES_1 * SAMPLES_PER_STRIDE; i++) {
  const f = i / (STRIDES_1 * SAMPLES_PER_STRIDE);
  stops.push({ t: f * RUN1_END, phase: f * STRIDES_1 });
}
stops.push({ t: DRINK_END, phase: STRIDES_1 });
for (let i = 1; i <= STRIDES_2 * SAMPLES_PER_STRIDE; i++) {
  const f = i / (STRIDES_2 * SAMPLES_PER_STRIDE);
  stops.push({ t: DRINK_END + f * (1 - DRINK_END), phase: STRIDES_1 + f * STRIDES_2 });
}

/**
 * A leg's timeline. `offset` phases the diagonal trot; `drink` is the angle it
 * holds at the fountain — the front legs come up onto the pulpulak while the
 * back legs stay planted, so the two cannot share one set of keyframes.
 */
const gait = (offset: number, drink: number) => {
  // The generated stops land exactly ON the window boundaries, so testing for
  // "strictly inside" matched none of them and the drink pose never appeared.
  // Insert stops just inside the window instead.
  const frames = stops
    .filter((s) => s.t <= RUN1_END + 1e-9 || s.t >= DRINK_END - 1e-9)
    .map((s) => ({ t: s.t, angle: Math.sin((s.phase + offset) * Math.PI * 2) * SWING }));
  frames.push({ t: RUN1_END + 0.035, angle: drink });
  frames.push({ t: DRINK_END - 0.015, angle: drink });
  frames.sort((a, b) => a.t - b.t);
  return frames.map((f) => `${pct(f.t)}{transform:rotate(${f.angle.toFixed(1)}deg)}`).join('');
};

// A diagonal trot: front-left moves with back-right, so there are two phases —
// but front and back need different poses at the fountain, hence four sets.
const keyframes = `
/* Front paws land around y 76-82 in the rig — up on the fountain, and clear
   of the head, which sits above y 45 and would otherwise hide them. */
@keyframes dogFrontA{${gait(0, -72)}}
@keyframes dogFrontB{${gait(0.5, -58)}}
@keyframes dogBackA{${gait(0, 6)}}
@keyframes dogBackB{${gait(0.5, -8)}}
@keyframes dogRear{
0%,${pct(RUN1_END - 0.02)}{transform:rotate(0deg)}
${pct(RUN1_END + 0.03)}{transform:rotate(-22deg)}
${pct(DRINK_END - 0.01)}{transform:rotate(-22deg)}
${pct(DRINK_END + 0.03)}{transform:rotate(0deg)}
100%{transform:rotate(0deg)}
}
@keyframes dogBob{${[
  ...stops
    .filter((s) => s.t <= RUN1_END + 1e-9 || s.t >= DRINK_END - 1e-9)
    .map((s) => ({ t: s.t, y: Math.abs(Math.sin(s.phase * Math.PI * 2)) * -2.5 })),
  { t: RUN1_END + 0.035, y: 0 },
  { t: DRINK_END - 0.015, y: 0 },
]
  .sort((a, b) => a.t - b.t)
  .map((f) => `${pct(f.t)}{transform:translateY(${f.y.toFixed(2)}px)}`)
  .join('')}}
/* vw, not %: a percentage here would resolve against the dog's own width
   rather than the band, and it would barely move. --dog-stop is set by the
   band and moves left on narrow screens, where the pack takes up far more of
   the width and would otherwise still be covering the fountain. */
@keyframes dogTravel{
0%{transform:translateX(calc(var(--dog-stop) - 61vw))}
${pct(RUN1_END)}{transform:translateX(var(--dog-stop))}
${pct(DRINK_END)}{transform:translateX(var(--dog-stop))}
100%{transform:translateX(calc(var(--dog-stop) + 75vw))}
}
/* Up, not down: the basin sits above the dog's standing head height, so it
   reaches for the spout rather than stooping to it. The wobble is lapping. */
@keyframes dogHead{
0%,${pct(RUN1_END - 0.02)}{transform:rotate(0deg)}
${pct(RUN1_END + 0.03)}{transform:rotate(-20deg)}
${pct(RUN1_END + 0.07)}{transform:rotate(-27deg)}
${pct(RUN1_END + 0.11)}{transform:rotate(-20deg)}
${pct(RUN1_END + 0.15)}{transform:rotate(-27deg)}
${pct(RUN1_END + 0.19)}{transform:rotate(-20deg)}
${pct(RUN1_END + 0.23)}{transform:rotate(-27deg)}
${pct(DRINK_END - 0.01)}{transform:rotate(-20deg)}
${pct(DRINK_END + 0.03)}{transform:rotate(0deg)}
100%{transform:rotate(0deg)}
}
@keyframes dogTail{
0%,100%{transform:rotate(-12deg)}
50%{transform:rotate(14deg)}
}
`;
---

<style is:global set:html={keyframes}></style>

<span class:list={['dog', className]}>
  <svg viewBox="0 0 170 110" role="img" aria-label="A street dog running with the club">
    <g class="dog__bob">
      <!-- Pivots on the back paws, so rearing up lifts the front of the dog
           without sliding its hind feet along the ground. -->
      <g class="dog__rear">
      <!-- FAR legs, behind the body -->
      <g class="dog__leg dog__leg--back-b" style="--pivot:58px 66px">
        <path d="M58 66 L54 96" stroke={coatDark} stroke-width="9" stroke-linecap="round" />
        <path d="M54 96 L62 98" stroke={coatDark} stroke-width="8" stroke-linecap="round" />
      </g>
      <g class="dog__leg dog__leg--front-a" style="--pivot:116px 64px">
        <path d="M116 64 L114 96" stroke={coatDark} stroke-width="9" stroke-linecap="round" />
        <path d="M114 96 L122 98" stroke={coatDark} stroke-width="8" stroke-linecap="round" />
      </g>

      <!-- tail -->
      <g class="dog__tail">
        <path
          d="M40 52 Q22 46 18 30"
          fill="none"
          stroke={ink}
          stroke-width="11"
          stroke-linecap="round"
        />
        <path
          d="M40 52 Q22 46 18 30"
          fill="none"
          stroke={coat}
          stroke-width="6"
          stroke-linecap="round"
        />
      </g>

      <!-- body -->
      <path
        d="M40 50 Q44 40 62 40 L112 40 Q130 40 132 52 L132 62 Q130 72 112 72 L60 72 Q42 72 40 62 Z"
        fill={coat}
        stroke={ink}
        stroke-width="4.5"
        stroke-linejoin="round"
      />

      <!-- head, pivoting at the neck so it can drop to the basin -->
      <g class="dog__head">
        <path d="M126 50 L138 40" stroke={ink} stroke-width="14" stroke-linecap="round" />
        <path d="M126 50 L138 40" stroke={coat} stroke-width="9" stroke-linecap="round" />
        <path
          d="M130 34 Q130 22 143 22 Q156 22 157 32 L166 38 Q168 42 162 44 L150 45 Q132 45 130 34 Z"
          fill={coat}
          stroke={ink}
          stroke-width="4.5"
          stroke-linejoin="round"
        />
        <path d="M132 24 L128 12 L142 18 Z" fill={coat} stroke={ink} stroke-width="4" stroke-linejoin="round" />
        <circle cx="147" cy="31" r="2.6" fill={ink} />
        <circle cx="165" cy="40" r="2.4" fill={ink} />
      </g>

      <!-- NEAR legs, in front of the body -->
      <g class="dog__leg dog__leg--back-a" style="--pivot:62px 66px">
        <path d="M62 66 L58 97" stroke={ink} stroke-width="11" stroke-linecap="round" />
        <path d="M62 66 L58 97" stroke={coat} stroke-width="6.5" stroke-linecap="round" />
        <path d="M58 97 L67 99" stroke={ink} stroke-width="9" stroke-linecap="round" />
        <path d="M58 97 L67 99" stroke={coat} stroke-width="5" stroke-linecap="round" />
      </g>
      <g class="dog__leg dog__leg--front-b" style="--pivot:120px 64px">
        <path d="M120 64 L118 97" stroke={ink} stroke-width="11" stroke-linecap="round" />
        <path d="M120 64 L118 97" stroke={coat} stroke-width="6.5" stroke-linecap="round" />
        <path d="M118 97 L127 99" stroke={ink} stroke-width="9" stroke-linecap="round" />
        <path d="M118 97 L127 99" stroke={coat} stroke-width="5" stroke-linecap="round" />
      </g>
      </g>
    </g>
  </svg>
</span>

<style>
  .dog {
    display: block;
    animation: dogTravel 17s linear infinite;
  }

  .dog svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .dog :global(*) {
    transform-box: view-box;
  }

  .dog__bob {
    transform-origin: 85px 60px;
    animation: dogBob 17s linear infinite;
  }

  .dog__rear {
    transform-origin: 58px 97px;
    animation: dogRear 17s linear infinite;
  }

  .dog__leg {
    transform-origin: var(--pivot);
  }

  .dog__leg--front-a {
    animation: dogFrontA 17s linear infinite;
  }

  .dog__leg--front-b {
    animation: dogFrontB 17s linear infinite;
  }

  .dog__leg--back-a {
    animation: dogBackA 17s linear infinite;
  }

  .dog__leg--back-b {
    animation: dogBackB 17s linear infinite;
  }

  .dog__head {
    transform-origin: 130px 46px;
    animation: dogHead 17s linear infinite;
  }

  .dog__tail {
    transform-origin: 40px 52px;
    animation: dogTail 0.5s ease-in-out infinite alternate;
  }

  /* Park the dog at the fountain, mid-drink, rather than animating. */
  @media (prefers-reduced-motion: reduce) {
    .dog,
    .dog :global(*) {
      animation: none !important;
    }

    .dog {
      transform: translateX(var(--dog-stop));
    }

    .dog__rear {
      transform: rotate(-15deg);
    }

    .dog__head {
      transform: rotate(-24deg);
    }

    .dog__leg--front-a {
      transform: rotate(-72deg);
    }

    .dog__leg--front-b {
      transform: rotate(-58deg);
    }
  }
</style>
