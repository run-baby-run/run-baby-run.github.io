---
import RunningTrio from './RunningTrio.astro';
import Pack from './Pack.astro';
import Dog from './Dog.astro';
import Pulpulak from './Pulpulak.astro';
import Park from './Park.astro';
import RepublicSquare from './RepublicSquare.astro';
import Cafes from './Cafes.astro';
import KondTunnel from './KondTunnel.astro';

interface Props {
  /** Draw the whole club rather than the three figures from the logo. */
  pack?: boolean;
}

const { pack = false } = Astro.props;
---

<div class:list={['band', pack && 'band--pack']} aria-hidden="true">
  <div class="band__track">
    <!-- Scenery first, so everything else runs in front of it. -->
    <span class="band__tunnel"><KondTunnel /></span>
    <span class="band__square"><RepublicSquare /></span>
    <span class="band__cafes"><Cafes /></span>
    <span class="band__park"><Park /></span>
    <span class="band__fountain"><Pulpulak /></span>
    <span class="band__pack">{pack ? <Pack /> : <RunningTrio />}</span>
    <!-- After the pack, so the dog is nearest the viewer: any brush as it
         passes reads as depth rather than two things intersecting. -->
    <span class="band__dog"><Dog /></span>
  </div>
  <span class="band__ground"></span>
</div>

<style>
  /* A strip the pack crosses on its way to the join section: the runners go
     by, a street dog trails them, stops at the pulpulak for a drink, then
     chases after them. Decorative, so it is hidden from assistive tech — the
     schedule and CTA already say everything this says. */
  .band {
    /*
     * The figures, sized against the street rather than against the screen.
     *
     * The px floors used to be 110/76/44, which on a 390px phone made the pack
     * 28% of the street instead of the 21% it is on a desktop — and that extra
     * width is what left no room for the tunnel and the park, so both were
     * being hidden. Lower floors keep the phone close to the proportions the
     * wide layout has, and everything fits.
     */
    --pack: clamp(88px, 21vw, 250px);
    /* A runner's viewBox leaves empty space below the feet, so the pack is
       pulled down by that much to stand ON the ground line rather than above
       it. It is a share of the figure's height, which is a different share of
       the pack's width depending on how many figures are across it. */
    --pack-pull: -0.085;
    --dog: clamp(56px, 13vw, 160px);
    --fountain: clamp(30px, 7vw, 86px);
    /*
     * Where the dog pulls up — and through it where the fountain sits.
     *
     * vw, and it has to be: Dog.astro moves the dog with translateX, where a
     * percentage would resolve against the dog's own width rather than the
     * street, and the dog would stop a few pixels from where it started. The
     * band is full-bleed on the page, so vw and % of the track agree anyway.
     *
     * The tiers are for the tunnel: the dog has to pull up clear of its mouth,
     * and the mouth is a much bigger share of a narrow street.
     */
    --dog-stop: 18vw;
    --enter: calc(var(--pack) * -1.1);
    position: relative;
    overflow: hidden;
    background: var(--cream);
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }

  /* Six of us across instead of three, at close to the same figure size, so
     the pack is wider. The floor keeps the same relationship to the viewport
     that the trio's did — a floor set any higher inflates the figures on a
     narrow screen, which is what used to crowd the tunnel and the park off it. */
  .band--pack {
    --pack: clamp(132px, 34vw, 400px);
    --pack-pull: -0.064;
  }

  /* No fixed height: the track takes its height from the pack, so nothing can
     be clipped at the top. Everything else is absolutely placed against it. */
  .band__track {
    position: relative;
  }

  /* The figures run on the spot; translateX carries them across, and does not
     affect layout, so none of this can widen the page. */
  .band__pack {
    display: block;
    width: var(--pack);
    margin-bottom: calc(var(--pack) * var(--pack-pull));
    animation: cross 17s linear infinite;
  }

  /* A shade lower than the pack, so it sits nearer the viewer. */
  .band__dog {
    position: absolute;
    left: 0;
    bottom: calc(var(--dog) * -0.03);
    width: var(--dog);
  }

  /* Sits where the dog's muzzle comes down, so the two stay together however
     the sizes scale. */
  .band__fountain {
    position: absolute;
    bottom: 0;
    left: calc(var(--dog-stop) + var(--dog) * 0.63);
    display: block;
    width: var(--fountain);
  }

  /* Landmarks along the route. Slightly faded so the figures stay the
     subject; the square is taller than the strip and is meant to run off the
     top, the way a building does. */
  .band__park,
  .band__square,
  .band__cafes {
    position: absolute;
    bottom: 0;
    display: block;
    opacity: 0.85;
  }

  /* In the gap between the pulpulak and the square. Widths are a share of the
     band with only an upper cap — a px floor (as clamp() gives) stops these
     shrinking on a narrow screen, and the cafés end up on top of the square. */
  .band__cafes {
    left: 38%;
    width: min(28%, 360px);
  }

  /* Between the tunnel mouth and the cafés. */
  .band__park {
    left: 20%;
    width: min(17%, 210px);
  }

  .band__square {
    right: 2%;
    width: min(26%, 340px);
  }

  /* The mouth of the Kond tunnel, at the start of the street. Drawn at full
     strength rather than faded back with the other landmarks — it is a hole in
     a wall, and a translucent one reads as a smudge. The pack runs in front of
     it: the mouth faces the road, so runners coming out of it would be heading
     towards the viewer, which this side-on street cannot show. */
  .band__tunnel {
    position: absolute;
    bottom: 0;
    left: 0;
    display: block;
    width: min(20%, 250px);
  }

  .band__ground {
    display: block;
    height: 0;
    border-top: var(--line) solid var(--ink);
  }

  @keyframes cross {
    from {
      transform: translateX(var(--enter));
    }
    to {
      transform: translateX(100vw);
    }
  }

  /* The dog pulls up further along on a narrow street, so the fountain clears
     the tunnel mouth: the mouth is a fifth of the width whatever the screen,
     but the gap between the dog's stop and its muzzle is set by the dog's own
     size, which has a floor. */
  @media (max-width: 700px) {
    .band {
      --dog-stop: 14vw;
    }
  }

  /* Standing still off-canvas would just look like a gap, so park the pack
     in view instead. */
  @media (prefers-reduced-motion: reduce) {
    .band__pack {
      animation: none;
      transform: translateX(62vw);
    }
  }
</style>
