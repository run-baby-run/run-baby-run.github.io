---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Person } from '../data/site';
import StravaLink from './StravaLink.astro';

interface Props {
  person: Person;
  image: ImageMetadata;
  tilt?: number;
}

const { person, image, tilt = 0 } = Astro.props;
---

<li class="person reveal" style={`--tilt:${tilt}deg`}>
  <figure>
    <Image
      src={image}
      alt={person.alt}
      width={600}
      widths={[320, 600]}
      quality={72}
      sizes="(max-width: 700px) 88vw, 32vw"
      style={person.focus ? `object-position:${person.focus}` : undefined}
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      <span class="person__name">{person.name}</span>
      {person.surname && <span class="person__surname">{person.surname}</span>}
      <span class="person__role">{person.role}</span>
      <StravaLink id={person.strava} />
    </figcaption>
  </figure>
</li>

<style>
  .person {
    rotate: var(--tilt);
    transition: rotate 0.3s ease, transform 0.3s ease;
  }

  .person:hover {
    rotate: 0deg;
    transform: translateY(-4px);
  }

  .person figure {
    margin: 0;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    background: var(--cream);
    overflow: hidden;
  }

  .person img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-bottom: var(--line) solid var(--ink);
  }

  .person figcaption {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.9rem 1.1rem 1.1rem;
  }

  .person__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .person__surname {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--pink-text);
  }

  .person__role {
    margin-top: 0.35rem;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
