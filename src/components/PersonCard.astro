---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Person } from '../data/site';
import StravaLink from './StravaLink.astro';
import { byMember, slugify } from '../data/stats';

interface Props {
  person: Person;
  image: ImageMetadata;
  tilt?: number;
}

const { person, image, tilt = 0 } = Astro.props;
---

<li class="person reveal" style={`--tilt:${tilt}deg`}>
  <figure>
    <Image
      src={image}
      alt={person.alt}
      width={600}
      widths={[320, 600]}
      quality={72}
      sizes="(max-width: 700px) 88vw, 32vw"
      style={person.focus ? `object-position:${person.focus}` : undefined}
      loading="lazy"
      decoding="async"
    />
    <figcaption>
      <span class="person__name">{person.name}</span>
      {person.surname && <span class="person__surname">{person.surname}</span>}
      <span class="person__role">{person.role}</span>
      {
        byMember.has(person.name) && (
          <a class="person__stats" href={`/athletes/${slugify(person.name)}/`}>
            Bests →
          </a>
        )
      }
      <div class="person__links">
        <StravaLink id={person.strava} />
        {
          person.email && (
            <a class="person__mail" href={`mailto:${person.email}`}>
              <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true">
                <path
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.4"
                  stroke-linejoin="round"
                  d="M3 6h18v12H3z M3 6l9 7 9-7"
                />
              </svg>
              <span>Email</span>
            </a>
          )
        }
      </div>
    </figcaption>
  </figure>
</li>

<style>
  .person {
    rotate: var(--tilt);
    transition: rotate 0.3s ease, transform 0.3s ease;
  }

  .person:hover {
    rotate: 0deg;
    transform: translateY(-4px);
  }

  .person figure {
    margin: 0;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    background: var(--cream);
    overflow: hidden;
  }

  .person img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-bottom: var(--line) solid var(--ink);
  }

  .person figcaption {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 0.9rem 1.1rem 1.1rem;
  }

  .person__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .person__surname {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--pink-text);
  }

  .person__stats {
    margin-top: 0.4rem;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--pink-text);
  }

  /* The Strava pill carries its own top margin, so the row only needs to hold
     the two together and wrap them on a narrow card. */
  .person__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  /* Deliberately the same shape as the Strava pill — they are two ways to
     reach the same person and should not look like different kinds of thing. */
  .person__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.5rem;
    padding: 0.2rem 0.55rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    color: var(--ink);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .person__mail:hover {
    background: var(--pink);
    transform: translateY(-1px);
  }

  @media (prefers-reduced-motion: reduce) {
    .person__mail {
      transition: none;
    }
  }

  .person__role {
    margin-top: 0.35rem;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }
</style>
