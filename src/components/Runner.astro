---
/**
 * One articulated runner, facing right, drawn to match the club logo: heavy
 * ink outlines, flat fills, pink/white/black kit.
 *
 * The figure is a rig, not a picture — hips, knees, shoulders and elbows are
 * separate groups rotated by CSS keyframes, so this is an actual run cycle
 * rather than a bouncing bitmap. Joint pivots are given in viewBox units,
 * which is what `transform-box: view-box` buys us.
 *
 * Cycle timing: one full cycle is two footfalls, so the body bob runs at
 * double the leg rate. The far-side limbs use mirrored keyframes rather than a
 * 50% delay, so a single `--delay` can phase the whole figure against its
 * neighbours without desyncing its own limbs.
 */

interface Props {
  /** Kit colours, matched to the three runners in the logo. */
  shirt: string;
  shorts: string;
  legs: string;
  shoe: string;
  /** The logo has two caps and one bun. */
  head?: 'cap' | 'bun';
  /** Skin tone for the face. */
  skin?: string;
  /** Negative seconds, to stagger the trio out of phase. */
  delay?: number;
  /** Give this one a watch: they start it setting off, and glance at it. */
  watch?: boolean;
  class?: string;
}

const {
  shirt,
  shorts,
  legs,
  shoe,
  head = 'cap',
  skin = '#f7f6f4',
  delay = 0,
  watch = false,
  class: className,
} = Astro.props;

const ink = '#141414';
// A black cap on a black shirt would vanish, so it flips to cream.
const capFill = shirt === ink ? '#f7f6f4' : ink;

/**
 * The watch arm can't just keep swinging under the check — you hold your wrist
 * still to read it. A 0.58s loop has no idea where it is in the 17s band
 * timeline, so for this one runner the arm swing is generated across the whole
 * loop instead, holding a raised pose through each glance.
 */
const BAND = 17; // seconds
const STRIDE = 0.58;
const HOLDS: [number, number][] = [
  [0.028, 0.118],
  [0.463, 0.557],
  [0.763, 0.857],
];
const inHold = (t: number) => HOLDS.some(([a, b]) => t >= a && t <= b);

function armTrack(amp: number, mid: number, held: number) {
  const cycles = BAND / STRIDE;
  const samples = Math.round(cycles * 4);
  const frames: { t: number; a: number }[] = [];
  for (let i = 0; i <= samples; i++) {
    const t = i / samples;
    if (inHold(t)) continue;
    frames.push({ t, a: mid + Math.sin(t * cycles * Math.PI * 2) * amp });
  }
  // Ease into and out of the held pose rather than snapping to it.
  for (const [a, b] of HOLDS) {
    frames.push({ t: a, a: held }, { t: b, a: held });
  }
  frames.sort((x, y) => x.t - y.t);
  return frames
    .map((f) => `${(f.t * 100).toFixed(2)}%{transform:rotate(${f.a.toFixed(1)}deg)}`)
    .join('');
}

const watchKeyframes = watch
  ? `@keyframes watch-upperarm{${armTrack(32, -2, -6)}}
@keyframes watch-forearm{${armTrack(12, -84, -96)}}`
  : '';
---

{watch && <style is:global set:html={watchKeyframes} />}

<svg
  class:list={['runner', className]}
  viewBox="0 0 130 170"
  role="img"
  aria-label="A runner mid-stride"
  style={`--delay:${delay}s`}
>
  <g class="runner__body">
    <!-- FAR limbs first, so the near side overlaps them -->
    <g class="runner__leg runner__leg--far">
      <g class="runner__thigh">
        <path d="M60 92 L60 118" stroke={ink} stroke-width="16" stroke-linecap="round" />
        <path d="M60 92 L60 118" stroke={legs} stroke-width="10" stroke-linecap="round" />
        <g class="runner__shin">
          <path d="M60 118 L60 141" stroke={ink} stroke-width="14" stroke-linecap="round" />
          <path d="M60 118 L60 141" stroke={legs} stroke-width="8" stroke-linecap="round" />
          <g class="runner__foot">
            <path
              d="M55 137 L74 137 Q82 137 82 143 Q82 147 76 147 L57 147 Q53 147 53 142 Z"
              fill={shoe}
              stroke={ink}
              stroke-width="4"
              stroke-linejoin="round"
            />
          </g>
        </g>
      </g>
    </g>

    <g class="runner__arm runner__arm--far">
      <g class="runner__upperarm">
        <path d="M64 60 L64 79" stroke={ink} stroke-width="13" stroke-linecap="round" />
        <path d="M64 60 L64 79" stroke={shirt} stroke-width="7" stroke-linecap="round" />
        <g class="runner__forearm">
          <path d="M64 79 L64 96" stroke={ink} stroke-width="12" stroke-linecap="round" />
          <path d="M64 79 L64 96" stroke={skin} stroke-width="6" stroke-linecap="round" />
        </g>
      </g>
    </g>

    <!-- TORSO: a slight forward hunch, wider at the shoulders -->
    <path
      d="M48 58 Q46 46 60 44 L76 44 Q88 46 86 60 L83 84 Q82 95 70 95 L58 95 Q47 95 47 84 Z"
      fill={shirt}
      stroke={ink}
      stroke-width="4.5"
      stroke-linejoin="round"
    />
    <!-- SHORTS -->
    <path
      d="M47 84 L84 84 L82 101 Q82 105 76 105 L55 105 Q49 105 49 100 Z"
      fill={shorts}
      stroke={ink}
      stroke-width="4.5"
      stroke-linejoin="round"
    />

    <!-- HEAD, in profile facing right. The look group tips the whole head down
         towards the wrist during a watch check, on top of the running nod. -->
    <g class:list={['runner__look', watch && 'runner__look--live']}>
    <g class="runner__head">
      <!-- neck -->
      <path d="M68 44 L68 36" stroke={ink} stroke-width="11" stroke-linecap="round" />
      <!-- Round head with a small nose bump on the profile; anything more
           pointed reads as a beak at this weight. -->
      <path
        d="M58 30 Q58 15 73 15 Q88 15 88 29 Q88 31 90 33 Q88 35 87 36 Q85 45 76 45 L69 45 Q59 45 58 34 Z"
        fill={skin}
        stroke={ink}
        stroke-width="4.5"
        stroke-linejoin="round"
      />
      <!-- eye -->
      <circle cx="80" cy="28" r="2.4" fill={ink} />
      {
        head === 'cap' ? (
          <path
            d="M57 25 Q57 11 73 11 Q89 11 89 25 L103 26 Q105 31 96 31 L57 30 Z"
            fill={capFill}
            stroke={ink}
            stroke-width="4"
            stroke-linejoin="round"
          />
        ) : (
          <>
            <path d="M57 27 Q56 12 73 12 Q89 12 88 27 Q80 20 72 20 Q63 20 57 27 Z" fill={ink} />
            <circle cx="62" cy="9" r="8" fill={ink} stroke={ink} stroke-width="3" />
          </>
        )
      }
    </g>
    </g>

    <!-- NEAR limbs. The watch-check group wraps the arm and adds a rotation
         ON TOP of the gait, so the arm keeps swinging while it comes up. -->
    <g class:list={['runner__check', watch && 'runner__check--live']}>
      <g class:list={['runner__arm', 'runner__arm--near', watch && 'runner__arm--watch']}>
        <g class="runner__upperarm">
          <path d="M66 60 L66 79" stroke={ink} stroke-width="14" stroke-linecap="round" />
          <path d="M66 60 L66 79" stroke={shirt} stroke-width="8" stroke-linecap="round" />
          <g class="runner__forearm">
            <path d="M66 79 L66 96" stroke={ink} stroke-width="13" stroke-linecap="round" />
            <path d="M66 79 L66 96" stroke={skin} stroke-width="7" stroke-linecap="round" />
            {
              watch && (
                <g class="runner__watch">
                  <rect x="58.5" y="85" width="15" height="12" rx="3.5" fill={ink} />
                  <rect x="61" y="87.5" width="10" height="7" rx="2" fill="#3d3d3d" />
                </g>
              )
            }
          </g>
        </g>
      </g>
    </g>

    <g class="runner__leg runner__leg--near">
      <g class="runner__thigh">
        <path d="M64 92 L64 118" stroke={ink} stroke-width="18" stroke-linecap="round" />
        <path d="M64 92 L64 118" stroke={legs} stroke-width="12" stroke-linecap="round" />
        <g class="runner__shin">
          <path d="M64 118 L64 141" stroke={ink} stroke-width="16" stroke-linecap="round" />
          <path d="M64 118 L64 141" stroke={legs} stroke-width="10" stroke-linecap="round" />
          <g class="runner__foot">
            <path
              d="M59 137 L79 137 Q87 137 87 143 Q87 148 81 148 L61 148 Q57 148 57 142 Z"
              fill={shoe}
              stroke={ink}
              stroke-width="4"
              stroke-linejoin="round"
            />
          </g>
        </g>
      </g>
    </g>
  </g>
</svg>

<style>
  .runner {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* Every joint pivots in viewBox coordinates. */
  .runner * {
    transform-box: view-box;
  }

  .runner__body {
    transform-origin: 64px 94px;
    animation: body-bob 0.58s linear infinite;
    animation-delay: var(--delay);
  }

  .runner__leg--near .runner__thigh,
  .runner__leg--far .runner__thigh {
    transform-origin: 62px 92px;
    animation: thigh 0.58s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .runner__leg--far .runner__thigh {
    animation-name: thigh-far;
  }

  .runner__shin {
    transform-origin: 62px 118px;
    animation: shin 0.58s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .runner__leg--far .runner__shin {
    animation-name: shin-far;
  }

  .runner__foot {
    transform-origin: 62px 139px;
    animation: foot 0.58s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .runner__leg--far .runner__foot {
    animation-name: foot-far;
  }

  .runner__arm--near .runner__upperarm,
  .runner__arm--far .runner__upperarm {
    transform-origin: 65px 60px;
    animation: upperarm 0.58s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .runner__arm--far .runner__upperarm {
    animation-name: upperarm-far;
  }

  .runner__forearm {
    transform-origin: 65px 79px;
    animation: forearm 0.58s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .runner__arm--far .runner__forearm {
    animation-name: forearm-far;
  }

  .runner__head {
    transform-origin: 68px 47px;
    animation: head-nod 0.58s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  /* Rides on the 17s band timeline rather than the stride: they thumb the
     watch setting off, then glance at it twice on the way past. The rotation
     stacks on top of the arm swing, so the gait carries on underneath.
     The wrist only comes to chest height — the head does the rest of the
     work, the way it does when you actually check a watch mid-run. */
  .runner__check--live {
    transform-origin: 65px 60px;
    animation: check-watch 17s linear infinite;
  }

  .runner__look--live {
    transform-origin: 68px 47px;
    animation: look-watch 17s linear infinite;
  }

  /* Swing generated across the whole band loop, so it can hold still while
     she reads the watch. Overrides the shared 0.58s arm animations. */
  .runner__arm--watch .runner__upperarm {
    animation: watch-upperarm 17s linear infinite;
    animation-delay: 0s;
  }

  .runner__arm--watch .runner__forearm {
    animation: watch-forearm 17s linear infinite;
    animation-delay: 0s;
  }

  @keyframes check-watch {
    0%, 1.5% { transform: rotate(0deg); }
    4% { transform: rotate(-32deg); }
    9% { transform: rotate(-30deg); }
    12% { transform: rotate(0deg); }
    45% { transform: rotate(0deg); }
    48% { transform: rotate(-28deg); }
    53% { transform: rotate(-28deg); }
    56% { transform: rotate(0deg); }
    75% { transform: rotate(0deg); }
    78% { transform: rotate(-28deg); }
    83% { transform: rotate(-28deg); }
    86% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }

  /* Positive is clockwise, so for a figure facing right this dips the chin
     down towards the wrist. */
  @keyframes look-watch {
    0%, 1.5% { transform: rotate(0deg); }
    4% { transform: rotate(26deg); }
    9% { transform: rotate(24deg); }
    12% { transform: rotate(0deg); }
    45% { transform: rotate(0deg); }
    48% { transform: rotate(24deg); }
    53% { transform: rotate(24deg); }
    56% { transform: rotate(0deg); }
    75% { transform: rotate(0deg); }
    78% { transform: rotate(24deg); }
    83% { transform: rotate(24deg); }
    86% { transform: rotate(0deg); }
    100% { transform: rotate(0deg); }
  }

  /* Forward lean is clockwise for a figure facing right. Two footfalls per
     cycle, so the bob peaks twice. */
  @keyframes body-bob {
    0%, 50%, 100% { transform: rotate(7deg) translateY(0); }
    25%, 75% { transform: rotate(7deg) translateY(-6px); }
  }

  /* SIGNS MATTER. Positive rotation is clockwise, and these limbs hang
     downward, so a POSITIVE angle swings the free end backwards (left) and a
     negative one swings it forwards (right). Getting this backwards mirrors
     the whole cycle: the knee bends the wrong way and the figure moonwalks.
     Thigh: negative reaches the knee forward, positive drives it behind.
     Shin: positive folds the heel up behind, which is how a knee works. */
  @keyframes thigh {
    0%   { transform: rotate(-34deg); }  /* reach, about to land */
    25%  { transform: rotate(-2deg); }   /* stance, under the hip */
    50%  { transform: rotate(34deg); }   /* toe-off, behind */
    75%  { transform: rotate(4deg); }    /* knee driving through */
    100% { transform: rotate(-34deg); }
  }

  @keyframes thigh-far {
    0%   { transform: rotate(34deg); }
    25%  { transform: rotate(4deg); }
    50%  { transform: rotate(-34deg); }
    75%  { transform: rotate(-2deg); }
    100% { transform: rotate(34deg); }
  }

  @keyframes shin {
    0%   { transform: rotate(14deg); }   /* almost straight to land */
    25%  { transform: rotate(4deg); }    /* straight under load */
    50%  { transform: rotate(62deg); }   /* heel kicking up behind */
    75%  { transform: rotate(96deg); }   /* folded tight, swinging through */
    100% { transform: rotate(14deg); }
  }

  @keyframes shin-far {
    0%   { transform: rotate(62deg); }
    25%  { transform: rotate(96deg); }
    50%  { transform: rotate(14deg); }
    75%  { transform: rotate(4deg); }
    100% { transform: rotate(62deg); }
  }

  @keyframes foot {
    0%   { transform: rotate(-8deg); }
    25%  { transform: rotate(4deg); }
    50%  { transform: rotate(26deg); }
    75%  { transform: rotate(10deg); }
    100% { transform: rotate(-8deg); }
  }

  @keyframes foot-far {
    0%   { transform: rotate(26deg); }
    25%  { transform: rotate(10deg); }
    50%  { transform: rotate(-8deg); }
    75%  { transform: rotate(4deg); }
    100% { transform: rotate(26deg); }
  }

  /* Arms oppose the legs: at 0% the near LEG is reaching forward, so the near
     ARM must be back — positive, by the same sign rule as above. */
  @keyframes upperarm {
    0%   { transform: rotate(30deg); }
    50%  { transform: rotate(-34deg); }
    100% { transform: rotate(30deg); }
  }

  @keyframes upperarm-far {
    0%   { transform: rotate(-34deg); }
    50%  { transform: rotate(30deg); }
    100% { transform: rotate(-34deg); }
  }

  @keyframes forearm {
    0%   { transform: rotate(-72deg); }
    50%  { transform: rotate(-96deg); }
    100% { transform: rotate(-72deg); }
  }

  @keyframes forearm-far {
    0%   { transform: rotate(-96deg); }
    50%  { transform: rotate(-72deg); }
    100% { transform: rotate(-96deg); }
  }

  @keyframes head-nod {
    0%, 100% { transform: rotate(2deg); }
    50% { transform: rotate(-2deg); }
  }

  /* Hold a clean mid-stride pose rather than animating. */
  @media (prefers-reduced-motion: reduce) {
    .runner *,
    .runner__body {
      animation: none !important;
    }

    .runner__body { transform: rotate(7deg); }
    .runner__leg--near .runner__thigh { transform: rotate(-30deg); }
    .runner__leg--near .runner__shin { transform: rotate(12deg); }
    .runner__leg--near .runner__foot { transform: rotate(-6deg); }
    .runner__leg--far .runner__thigh { transform: rotate(30deg); }
    .runner__leg--far .runner__shin { transform: rotate(70deg); }
    .runner__leg--far .runner__foot { transform: rotate(20deg); }
    .runner__arm--near .runner__upperarm { transform: rotate(26deg); }
    .runner__arm--near .runner__forearm { transform: rotate(-74deg); }
    .runner__arm--far .runner__upperarm { transform: rotate(-30deg); }
    .runner__arm--far .runner__forearm { transform: rotate(-94deg); }
  }
</style>
