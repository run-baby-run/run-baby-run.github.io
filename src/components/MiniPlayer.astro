---
import { playlist } from '../data/song';
---

<div class="mini" id="rbr-mini" hidden data-tracks={JSON.stringify(playlist)}>
  <button class="mini__step" type="button" data-mini-prev aria-label="Previous take">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M16 5.5v13L7 12zM6 5h2.2v14H6z" />
    </svg>
  </button>

  <button class="mini__toggle" type="button" data-mini-toggle aria-label="Pause the club song">
    <svg class="mini__icon mini__icon--play" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5.5v13l11-6.5z" />
    </svg>
    <svg class="mini__icon mini__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5h3.2v14H8zM12.8 5H16v14h-3.2z" />
    </svg>
  </button>

  <button class="mini__step" type="button" data-mini-next aria-label="Next take">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M8 5.5v13L17 12zM15.8 5H18v14h-2.2z" />
    </svg>
  </button>

  <a class="mini__text" href="/#song">
    <span class="mini__title" data-mini-song>{playlist[0].song}</span>
    <span class="mini__time"><span data-mini-take>{playlist[0].take} / {playlist[0].takes}</span> · <span data-mini-time>0:00</span></span>
  </a>

  <button class="mini__close" type="button" data-mini-close aria-label="Stop the club song">✕</button>

  <span class="mini__bar" aria-hidden="true"><span data-mini-progress></span></span>
</div>

<script>
  // One controller for the whole site. The <audio> and this bar are persisted
  // across navigations by transition:persist, so global listeners are bound
  // once; the full player on the home page is re-wired after every navigation.
  interface PageUi {
    root: HTMLElement;
    toggle: HTMLButtonElement;
    seek: HTMLInputElement;
    current: HTMLElement;
    duration: HTMLElement;
    song: HTMLElement | null;
    take: HTMLElement | null;
    download: HTMLAnchorElement | null;
  }

  /**
   * Keeps the song name, take label, duration and download link on the loaded
   * track. The count is within the SONG — "2 / 4" of Just Show Up — not the
   * position in the flat playlist, which would keep climbing as songs are added.
   */
  function labelTrack(i: number) {
    const list = trackList();
    const entry = list[i];
    if (!entry) return;
    const count = `${entry.take} / ${entry.takes}`;

    const miniTake = document.querySelector<HTMLElement>('[data-mini-take]');
    if (miniTake) miniTake.textContent = count;
    const miniSong = document.querySelector<HTMLElement>('[data-mini-song]');
    if (miniSong) miniSong.textContent = entry.song;

    const page = w.__rbrPage;
    if (!page) return;
    if (page.song) page.song.textContent = entry.song;
    if (page.take) page.take.textContent = `${count} · ${entry.label}`;
    page.duration.textContent = entry.duration;
    if (page.download) {
      page.download.href = entry.file;
      // The club name prefixes the file, unless the song is already called it.
      const base = entry.song.startsWith('Run Baby Run')
        ? entry.song
        : `Run Baby Run — ${entry.song}`;
      page.download.download = `${base} (${entry.label}).mp3`;
    }
  }

  const w = window as typeof window & { __rbrPage?: PageUi | null };

  // Every binding is guarded by a flag on the element itself rather than a
  // global: only the <audio> is reliably persisted across a navigation, so
  // any node that gets recreated must be re-bound, and any node that survives
  // must not be bound twice.
  const claim = (el: HTMLElement) => {
    if (el.dataset.rbrBound === 'true') return false;
    el.dataset.rbrBound = 'true';
    return true;
  };

  const playPause = (a: HTMLAudioElement) => {
    if (a.paused) a.play().catch(() => {});
    else a.pause();
  };

  const fmt = (s: number) =>
    Number.isFinite(s) && s >= 0
      ? `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`
      : '0:00';

  const audio = () => document.getElementById('rbr-audio') as HTMLAudioElement | null;
  const mini = () => document.getElementById('rbr-mini');

  interface Track {
    label: string;
    file: string;
    duration: string;
    /** Which song the take belongs to, so the counter can reset per song. */
    song: string;
    take: number;
    takes: number;
  }

  const trackList = (): Track[] => {
    const raw = mini()?.dataset.tracks;
    return raw ? (JSON.parse(raw) as Track[]) : [];
  };

  /** Which take is loaded. Kept on the <audio> so it survives navigation with
   *  it. Named currentTrack, not current: bindPage has a `current` element. */
  const currentTrack = () => Number(audio()?.dataset.track ?? 0);

  function loadTrack(next: number, play: boolean) {
    const a = audio();
    const list = trackList();
    if (!a || list.length === 0) return;

    const i = (next + list.length) % list.length;
    a.dataset.track = String(i);
    a.src = list[i].file;
    // No a.load() here: it forces the resource-selection algorithm and Chrome
    // fetches the file even under preload="none", so stepping through the
    // takes while paused would download all four.

    labelTrack(i);
    paint();
    if (play) a.play().catch(() => {});
  }

  function paint() {
    const a = audio();
    const m = mini();
    if (!a || !m) return;

    const pct = a.duration ? (a.currentTime / a.duration) * 100 : 0;
    const bar = m.querySelector<HTMLElement>('[data-mini-progress]');
    if (bar) bar.style.width = `${pct}%`;
    const time = m.querySelector<HTMLElement>('[data-mini-time]');
    if (time) time.textContent = fmt(a.currentTime);

    const page = w.__rbrPage;
    if (page) {
      page.seek.value = String(pct * 10);
      page.seek.style.setProperty('--progress', `${pct}%`);
      page.current.textContent = fmt(a.currentTime);
      if (a.duration) page.duration.textContent = fmt(a.duration);
    }
  }

  function setPlaying(playing: boolean) {
    const m = mini();
    if (m) {
      m.classList.toggle('is-playing', playing);
      const t = m.querySelector('[data-mini-toggle]');
      t?.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} the club song`);
      if (playing) m.hidden = false;
    }
    const page = w.__rbrPage;
    if (page) {
      page.root.classList.toggle('is-playing', playing);
      page.toggle.setAttribute('aria-label', `${playing ? 'Pause' : 'Play'} the club song`);
    }
  }

  function bindGlobal() {
    const a = audio();
    const m = mini();
    if (!a || !m) return;

    if (claim(m)) {
      m.querySelector('[data-mini-toggle]')?.addEventListener('click', () => playPause(a));
      m.querySelector('[data-mini-prev]')?.addEventListener('click', () =>
        loadTrack(currentTrack() - 1, !a.paused)
      );
      m.querySelector('[data-mini-next]')?.addEventListener('click', () =>
        loadTrack(currentTrack() + 1, !a.paused)
      );
      m.querySelector('[data-mini-close]')?.addEventListener('click', () => {
        a.pause();
        a.currentTime = 0;
        m.hidden = true;
        paint();
      });
    }

    if (!claim(a)) return;

    a.addEventListener('play', () => setPlaying(true));
    a.addEventListener('pause', () => setPlaying(false));
    // Roll on to the next take. This is not autoplay — playback was already
    // started by hand — so it only ever continues an existing session. At the
    // end of the last take it stops and rewinds to the first, rather than
    // looping the same song round for ever.
    a.addEventListener('ended', () => {
      const next = currentTrack() + 1;
      if (next < trackList().length) {
        loadTrack(next, true);
        return;
      }
      setPlaying(false);
      m.hidden = true;
      loadTrack(0, false);
    });
    a.addEventListener('timeupdate', paint);
    a.addEventListener('loadedmetadata', paint);
  }

  // Re-attach the home page's full player after each navigation.
  function bindPage() {
    const a = audio();
    const root = document.querySelector<HTMLElement>('[data-player]');
    if (!a || !root) {
      w.__rbrPage = null;
      return;
    }

    const ui = root.querySelector<HTMLElement>('[data-ui]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const seek = root.querySelector<HTMLInputElement>('[data-seek]');
    const current = root.querySelector<HTMLElement>('[data-current]');
    const duration = root.querySelector<HTMLElement>('[data-duration]');
    if (!ui || !toggle || !seek || !current || !duration) return;

    ui.hidden = false;
    w.__rbrPage = {
      root,
      toggle,
      seek,
      current,
      duration,
      song: root.querySelector<HTMLElement>('[data-song]'),
      take: root.querySelector<HTMLElement>('[data-take]'),
      download: root.querySelector<HTMLAnchorElement>('[data-download]'),
    };

    // Whichever take is loaded may not be the first — the audio persists
    // across navigations, so the freshly rendered labels need syncing.
    labelTrack(currentTrack());

    // astro:page-load also fires on the initial load, so binding must be
    // idempotent — a second click handler would pause playback the instant
    // the first one started it (play() clears .paused synchronously).
    if (!claim(root)) {
      setPlaying(!a.paused);
      paint();
      return;
    }

    toggle.addEventListener('click', () => playPause(a));
    root
      .querySelector('[data-prev]')
      ?.addEventListener('click', () => loadTrack(currentTrack() - 1, !a.paused));
    root
      .querySelector('[data-next]')
      ?.addEventListener('click', () => loadTrack(currentTrack() + 1, !a.paused));

    seek.addEventListener('input', () => {
      const pct = Number(seek.value) / 10;
      seek.style.setProperty('--progress', `${pct}%`);
      if (a.duration) current.textContent = fmt((pct / 100) * a.duration);
    });

    seek.addEventListener('change', () => {
      if (a.duration) a.currentTime = (Number(seek.value) / 1000) * a.duration;
    });

    setPlaying(!a.paused);
    paint();
  }

  function init() {
    bindGlobal();
    bindPage();
    const a = audio();
    const m = mini();
    // No play/pause event fires across a navigation, so restore the icon and
    // the bar's visibility from the audio element's actual state.
    if (a) setPlaying(!a.paused);
    if (a && m && (!a.paused || a.currentTime > 0)) m.hidden = false;
    paint();
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .mini {
    position: fixed;
    z-index: 40;
    left: clamp(0.75rem, 3vw, 1.5rem);
    bottom: clamp(0.75rem, 3vw, 1.5rem);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem 0.5rem 0.5rem;
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }

  .mini[hidden] {
    display: none;
  }

  .mini__toggle,
  .mini__close,
  .mini__step {
    flex: none;
    display: grid;
    place-items: center;
    padding: 0;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .mini__step {
    width: 1.9rem;
    height: 1.9rem;
    background: var(--cream);
    color: var(--ink);
  }

  .mini__step:hover {
    background: var(--pink);
  }

  .mini__step svg {
    width: 0.85rem;
    height: 0.85rem;
    fill: currentColor;
  }

  .mini__toggle {
    width: 2.5rem;
    height: 2.5rem;
    background: var(--ink);
    color: var(--cream);
  }

  .mini__toggle:hover {
    background: var(--pink);
    color: var(--ink);
  }

  .mini__icon {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .mini__icon--pause,
  .mini.is-playing .mini__icon--play {
    display: none;
  }

  .mini.is-playing .mini__icon--pause {
    display: block;
  }

  .mini__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
    text-decoration: none;
  }

  .mini__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    text-transform: uppercase;
  }

  .mini__time {
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  .mini__close {
    width: 1.75rem;
    height: 1.75rem;
    background: transparent;
    color: var(--ink);
    font-size: 0.75rem;
    line-height: 1;
  }

  .mini__close:hover {
    background: var(--pink);
  }

  .mini__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .mini__bar span {
    display: block;
    height: 100%;
    width: 0%;
    background: var(--pink-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .mini__toggle,
    .mini__close {
      transition: none;
    }
  }
</style>
