---
import { songs, playlist } from '../data/song';

const first = playlist[0];
---

<section class="song" id="song">
  <img class="song__mark" src="/images/runners.png" alt="" width="449" height="397" loading="lazy" />

  <div class="wrap song__inner">
    <div class="song__intro">
      <p class="eyebrow song__eyebrow">Turn it up</p>
      <h2>We wrote<br />club songs.</h2>
      <p class="song__note">
        Two of them, written for the Tuesday ten o’clock run. Each has a few takes —
        same words, different arrangements. Play them all the way through and they roll
        on from one to the next.
      </p>
    </div>

    <div class="player sticker" data-player>
      <!-- The audio element itself lives in the layout so playback survives
           navigation; this is only the fallback for a scriptless browser. -->
      <noscript>
        {
          playlist.map((track) => (
            <p class="player__fallback">
              <strong>
                {track.song} · {track.take} / {track.takes} · {track.label}
              </strong>
              <audio class="player__audio" src={track.file} preload="none" controls />
            </p>
          ))
        }
      </noscript>

      <div class="player__ui" hidden data-ui>
        <button class="player__step" type="button" data-prev aria-label="Previous take">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M16 5.5v13L7 12zM6 5h2.2v14H6z" />
          </svg>
        </button>

        <button class="player__toggle" type="button" data-toggle aria-label="Play the club song">
          <svg class="player__icon player__icon--play" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5z" />
          </svg>
          <svg class="player__icon player__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5h3.2v14H8zM12.8 5H16v14h-3.2z" />
          </svg>
        </button>

        <button class="player__step" type="button" data-next aria-label="Next take">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5.5v13L17 12zM15.8 5H18v14h-2.2z" />
          </svg>
        </button>

        <div class="player__body">
          <p class="player__title">
            <span data-song>{first.song}</span>
            <span class="player__take" data-take>{first.take} / {first.takes} · {first.label}</span>
          </p>
          <input
            class="player__seek"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="1"
            data-seek
            aria-label="Seek"
          />
          <p class="player__times">
            <span data-current>0:00</span>
            <span class="player__actions">
              <button class="player__act" type="button" data-share>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 16V4m0 0L8 8m4-4 4 4M5 14v4.5A1.5 1.5 0 0 0 6.5 20h11a1.5 1.5 0 0 0 1.5-1.5V14" />
                </svg>
                <span data-share-label>Share</span>
              </button>
              <a
                class="player__act"
                data-download
                href={first.file}
                download={`Run Baby Run — ${first.song} (${first.label}).mp3`}
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 3v10m0 0-4-4m4 4 4-4M5 19h14" />
                </svg>
                Download
              </a>
            </span>
            <span data-duration>{first.duration}</span>
          </p>
        </div>
      </div>
    </div>

    <div class="lyrics-set">
      {
        songs.map((s) => (
          <details class="lyrics">
            <summary>
              {s.title}
              <span class="lyrics__meta">
                {s.tracks.length > 0
                  ? `${s.tracks.length} take${s.tracks.length > 1 ? 's' : ''} · lyrics`
                  : 'Lyrics · not recorded yet'}
              </span>
            </summary>
            <div class="lyrics__body">
              {s.lyrics.map((stanza) => (
                <p>
                  {stanza.map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </p>
              ))}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .song {
    position: relative;
    overflow: hidden;
    background: var(--pink);
    border-block: var(--line) solid var(--ink);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .song__mark {
    position: absolute;
    right: -4%;
    top: 8%;
    width: min(28vw, 340px);
    opacity: 0.2;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .song__inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .song__eyebrow {
    background: var(--cream);
  }

  .song__note {
    margin: 1.25rem 0 2rem;
    max-width: 40ch;
  }

  /* ---- player ---- */
  .player {
    padding: 1.1rem 1.25rem;
    background: var(--cream);
  }

  .player__audio {
    width: 100%;
  }

  .player__ui {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .player__toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    padding: 0;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .player__toggle:hover {
    background: var(--pink);
    color: var(--ink);
    transform: translate(-1px, -1px);
  }

  .player__icon {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  .player__icon--pause,
  :global(.is-playing) .player__icon--play {
    display: none;
  }

  :global(.is-playing) .player__icon--pause {
    display: block;
  }

  .player__body {
    flex: 1;
    min-width: 0;
  }

  .player__step {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
    color: var(--ink);
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .player__step:hover {
    background: var(--pink);
    transform: translateY(-1px);
  }

  .player__step svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: currentColor;
  }

  .player__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .player__take {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink-soft);
  }

  .player__fallback {
    margin: 0 0 0.75rem;
  }

  .player__fallback strong {
    display: block;
    font-size: 0.8125rem;
    margin-bottom: 0.25rem;
  }

  .player__seek {
    --progress: 0%;
    width: 100%;
    height: 0.75rem;
    margin: 0;
    appearance: none;
    background: linear-gradient(
      to right,
      var(--pink-deep) var(--progress),
      color-mix(in srgb, var(--ink) 14%, transparent) var(--progress)
    );
    border: 2px solid var(--ink);
    border-radius: 999px;
    cursor: pointer;
  }

  .player__seek::-webkit-slider-thumb {
    appearance: none;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
  }

  .player__seek::-moz-range-thumb {
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
  }

  .player__seek:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .player__times {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  .player__actions {
    display: flex;
    gap: 0.4rem;
  }

  .player__act {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.15rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.15s ease;
    background: none;
    cursor: pointer;
  }

  .player__act:hover {
    background: var(--pink);
  }

  .player__act svg {
    width: 0.8rem;
    height: 0.8rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* ---- lyrics ---- */
  .lyrics-set {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .lyrics {
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--cream) 55%, transparent);
  }

  .lyrics summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.85rem 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .lyrics summary:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: -3px;
    border-radius: var(--radius);
  }

  .lyrics__meta {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
  }

  .lyrics__body {
    padding: 0 1.25rem 1.25rem;
    columns: 260px 2;
    column-gap: 2.5rem;
  }

  .lyrics__body p {
    break-inside: avoid;
    margin: 0 0 1.1rem;
    line-height: 1.5;
  }

  /* On a phone the three buttons leave the text beside them only ~100px, which
     is not enough for the seek bar, both times and the two pills — the duration
     ended up outside the card. Put the controls on their own line and give the
     rest the full width beneath them. */
  @media (max-width: 560px) {
    .player__ui {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.85rem;
    }

    .player__body {
      flex-basis: 100%;
    }

    .player__toggle {
      width: 3.25rem;
      height: 3.25rem;
    }

    .player__times {
      row-gap: 0.6rem;
    }

    .player__actions {
      order: 1;
      flex-basis: 100%;
      justify-content: center;
    }
  }

</style>
