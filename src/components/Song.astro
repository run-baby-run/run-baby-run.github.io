---
import { song, lyrics } from '../data/song';
---

<section class="song" id="song">
  <img class="song__mark" src="/images/runners.png" alt="" width="449" height="397" loading="lazy" />

  <div class="wrap song__inner">
    <div class="song__intro">
      <p class="eyebrow song__eyebrow">Turn it up</p>
      <h2>We wrote<br />a club song.</h2>
      <p class="song__note">{song.note}</p>
    </div>

    <div class="player sticker" data-player>
      <!-- The audio element itself lives in the layout so playback survives
           navigation; this is only the fallback for a scriptless browser. -->
      <noscript>
        <audio class="player__audio" src={song.file} preload="none" controls></audio>
      </noscript>

      <div class="player__ui" hidden data-ui>
        <button class="player__toggle" type="button" data-toggle aria-label={`Play ${song.title}`}>
          <svg class="player__icon player__icon--play" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5.5v13l11-6.5z" />
          </svg>
          <svg class="player__icon player__icon--pause" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M8 5h3.2v14H8zM12.8 5H16v14h-3.2z" />
          </svg>
        </button>

        <div class="player__body">
          <p class="player__title">{song.title}</p>
          <input
            class="player__seek"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="1"
            data-seek
            aria-label="Seek"
          />
          <p class="player__times">
            <span data-current>0:00</span>
            <span data-duration>{song.duration}</span>
          </p>
        </div>
      </div>
    </div>

    <details class="lyrics">
      <summary>Lyrics</summary>
      <div class="lyrics__body">
        {
          lyrics.map((stanza) => (
            <p>
              {stanza.map((line, i) => (
                <>
                  {i > 0 && <br />}
                  {line}
                </>
              ))}
            </p>
          ))
        }
      </div>
    </details>
  </div>
</section>

<style>
  .song {
    position: relative;
    overflow: hidden;
    background: var(--pink);
    border-block: var(--line) solid var(--ink);
    padding-block: clamp(3rem, 7vw, 5.5rem);
  }

  .song__mark {
    position: absolute;
    right: -4%;
    top: 8%;
    width: min(28vw, 340px);
    opacity: 0.2;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .song__inner {
    position: relative;
    z-index: 1;
    max-width: 780px;
  }

  .song__eyebrow {
    background: var(--cream);
  }

  .song__note {
    margin: 1.25rem 0 2rem;
    max-width: 40ch;
  }

  /* ---- player ---- */
  .player {
    padding: 1.1rem 1.25rem;
    background: var(--cream);
  }

  .player__audio {
    width: 100%;
  }

  .player__ui {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .player__toggle {
    flex: none;
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    padding: 0;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    cursor: pointer;
    box-shadow: var(--shadow-sm);
    transition: transform 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }

  .player__toggle:hover {
    background: var(--pink);
    color: var(--ink);
    transform: translate(-1px, -1px);
  }

  .player__icon {
    width: 1.5rem;
    height: 1.5rem;
    fill: currentColor;
  }

  .player__icon--pause,
  :global(.is-playing) .player__icon--play {
    display: none;
  }

  :global(.is-playing) .player__icon--pause {
    display: block;
  }

  .player__body {
    flex: 1;
    min-width: 0;
  }

  .player__title {
    margin: 0 0 0.4rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .player__seek {
    --progress: 0%;
    width: 100%;
    height: 0.75rem;
    margin: 0;
    appearance: none;
    background: linear-gradient(
      to right,
      var(--pink-deep) var(--progress),
      color-mix(in srgb, var(--ink) 14%, transparent) var(--progress)
    );
    border: 2px solid var(--ink);
    border-radius: 999px;
    cursor: pointer;
  }

  .player__seek::-webkit-slider-thumb {
    appearance: none;
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
  }

  .player__seek::-moz-range-thumb {
    width: 1.1rem;
    height: 1.1rem;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
  }

  .player__seek:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }

  .player__times {
    display: flex;
    justify-content: space-between;
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink-soft);
  }

  /* ---- lyrics ---- */
  .lyrics {
    margin-top: 1.75rem;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--cream) 55%, transparent);
  }

  .lyrics summary {
    padding: 0.85rem 1.25rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .lyrics summary:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: -3px;
    border-radius: var(--radius);
  }

  .lyrics__body {
    padding: 0 1.25rem 1.25rem;
    columns: 260px 2;
    column-gap: 2.5rem;
  }

  .lyrics__body p {
    break-inside: avoid;
    margin: 0 0 1.1rem;
    line-height: 1.5;
  }

  @media (max-width: 560px) {
    .player__ui {
      gap: 0.85rem;
    }

    .player__toggle {
      width: 3.25rem;
      height: 3.25rem;
    }
  }
</style>
