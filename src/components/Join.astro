---
import { site } from '../data/site';
---

<section class="section join" id="join">
  <div class="wrap join__inner">
    <h2>Just show up.<br />We'll take it<br />from there.</h2>
    <div class="join__actions">
      <a class="btn join__btn" href={site.whatsapp} target="_blank" rel="noopener">
        Join the WhatsApp group
      </a>
      <a class="btn btn--ghost join__btn" href={site.instagram} target="_blank" rel="noopener">
        Follow {site.instagramHandle}
      </a>
    </div>
  </div>
</section>

<style>
  .join {
    background: var(--ink);
    color: var(--cream);
  }

  .join__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4rem);
    align-items: center;
  }

  .join h2 {
    color: var(--cream);
  }

  .join__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .join__btn {
    background: var(--pink);
    color: var(--ink);
    border-color: var(--pink);
  }

  .join__btn:hover {
    background: var(--cream);
    border-color: var(--cream);
  }

  .join__btn.btn--ghost {
    background: transparent;
    color: var(--cream);
    border-color: var(--cream);
  }

  .join__btn.btn--ghost:hover {
    background: var(--green);
    color: var(--ink);
    border-color: var(--green);
  }

  @media (max-width: 820px) {
    .join__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
