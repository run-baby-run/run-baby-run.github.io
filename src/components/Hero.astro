---
import { site, runs } from '../data/site';
import RunningTrio from './RunningTrio.astro';
---

<section class="hero">
  <span class="hero__blob hero__blob--pink" aria-hidden="true"></span>
  <span class="hero__blob hero__blob--sage" aria-hidden="true"></span>

  <div class="wrap hero__inner">
    <div class="hero__copy">
      <p class="hero__pin"><span aria-hidden="true">📍</span> {site.city}</p>

      <!-- The logotype keeps the original artwork; the runners beside it are
           the animated rig, so the mark reads exactly as the logo but moves. -->
      <h1 class="hero__title">
        <img
          class="hero__wordmark"
          src="/images/wordmark.png"
          alt="Run Baby Run"
          width="360"
          height="368"
          fetchpriority="high"
        />
        <span class="hero__trio"><RunningTrio /></span>
      </h1>

      <p class="hero__tagline">{site.tagline}</p>

      <div class="hero__actions">
        <a class="btn" href={site.whatsapp} target="_blank" rel="noopener">Join the WhatsApp</a>
        <a class="btn btn--ghost" href="#schedule">See the schedule</a>
      </div>

      <ul class="hero__times" aria-label="Weekly run times">
        {
          runs.map((run) => (
            <li class={`hero__time hero__time--${run.accent}`}>
              <span class="hero__time-day">{run.day.slice(0, 3)}</span>
              <span class="hero__time-clock">{run.time}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="hero__photo sticker">
      <span class="hero__badge" aria-hidden="true">
        <span>Free</span>
        <span class="hero__badge-big">All</span>
        <span>paces</span>
      </span>
      <img
        src="/images/founders-1.jpg"
        alt="Runners gathering at a Run Baby Run meet-up in Yerevan"
        width="1170"
        height="780"
        loading="eager"
      />
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 6vw, 4.5rem) clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero__blob {
    position: absolute;
    border-radius: 50%;
    z-index: -1;
  }

  .hero__blob--pink {
    width: 40vw;
    aspect-ratio: 1;
    right: -12vw;
    top: 4vw;
    background: var(--pink);
    opacity: 0.55;
  }

  .hero__blob--sage {
    width: 26vw;
    aspect-ratio: 1;
    left: -16vw;
    bottom: -15vw;
    background: var(--sage);
    opacity: 0.5;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .hero__pin {
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }

  .hero__title {
    display: flex;
    align-items: center;
    gap: 2%;
    margin: 0 0 1.75rem;
    max-width: 620px;
  }

  .hero__wordmark {
    flex: 0 0 46%;
    width: 46%;
    height: auto;
  }

  /* A wrapper this component owns, so the scoped rule actually matches. */
  .hero__trio {
    display: block;
    flex: 0 0 52%;
    min-width: 0;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.5rem, 3.4vw, 2.35rem);
    line-height: 1.12;
    max-width: 17ch;
    margin: 0 0 2.25rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .hero__times {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }

  .hero__time {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.4rem 1rem;
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
  }

  .hero__time--pink {
    background: var(--pink);
  }
  .hero__time--sage {
    background: var(--sage);
  }

  .hero__time-day {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9375rem;
  }

  .hero__time-clock {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    font-size: 0.9375rem;
  }

  .hero__photo {
    position: relative;
    margin: 0;
    rotate: 2.5deg;
    transition: rotate 0.4s ease;
  }

  .hero__photo img {
    border-radius: calc(var(--radius) - 3px);
  }

  /* A stamped sticker on the corner of the photo. */
  .hero__badge {
    position: absolute;
    z-index: 2;
    top: -1.4rem;
    left: -1.4rem;
    display: grid;
    place-content: center;
    justify-items: center;
    width: 6.5rem;
    height: 6.5rem;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--sage);
    rotate: -14deg;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    box-shadow: var(--shadow-sm);
  }

  .hero__badge-big {
    font-size: 1.75rem;
    letter-spacing: -0.02em;
  }

  .hero__photo:hover {
    rotate: 0deg;
  }

  .hero__photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__photo {
      order: -1;
      rotate: -1.5deg;
      margin-bottom: 1.5rem;
    }

    .hero__badge {
      top: -1rem;
      left: auto;
      right: -0.75rem;
      width: 5.5rem;
      height: 5.5rem;
      font-size: 0.6875rem;
    }

    .hero__badge-big {
      font-size: 1.375rem;
    }

    .hero__tagline {
      max-width: none;
    }
  }
</style>
