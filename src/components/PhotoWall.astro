---
import type { Photo } from '../data/library';

interface Props {
  photos: Photo[];
}

const { photos } = Astro.props;

const day = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-GB', {
    weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });

/** The Monday of the week a date falls in, ISO-style. Sunday is day 0, and
 *  belongs to the week that started six days earlier — not the one starting
 *  tomorrow, which is what a naive subtraction gives. */
function monday(iso: string) {
  const d = new Date(iso + 'T12:00:00Z');
  const shift = (d.getUTCDay() + 6) % 7;
  d.setUTCDate(d.getUTCDate() - shift);
  return d.toISOString().slice(0, 10);
}

const add = (iso: string, days: number) => {
  const d = new Date(iso + 'T12:00:00Z');
  d.setUTCDate(d.getUTCDate() + days);
  return d.toISOString().slice(0, 10);
};

const part = (iso: string, opts: Intl.DateTimeFormatOptions) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-GB', { ...opts, timeZone: 'UTC' });

/** "1 – 7 September 2026", dropping whatever the two ends already share. */
function span(from: string, to: string) {
  const sameYear = from.slice(0, 4) === to.slice(0, 4);
  const sameMonth = sameYear && from.slice(5, 7) === to.slice(5, 7);
  const left = sameMonth
    ? part(from, { day: 'numeric' })
    : part(from, { day: 'numeric', month: 'long', ...(sameYear ? {} : { year: 'numeric' }) });
  return `${left} – ${part(to, { day: 'numeric', month: 'long', year: 'numeric' })}`;
}

/*
 * Grouped by the week they were taken.
 *
 * By day, most blocks were three or four photographs — too few for a mosaic to
 * be a mosaic, and the page turned into a column of thin strips separated by
 * headings. A week is two or three runs plus whatever else happened, which is
 * enough to pack properly. The individual dates are not lost: they are listed
 * under the heading, each one linking into that day in the diary, and every
 * photograph carries its own date into the lightbox.
 */
const weeks: { start: string; photos: Photo[]; days: string[] }[] = [];
for (const photo of photos) {
  const start = monday(photo.date);
  if (weeks.at(-1)?.start !== start) weeks.push({ start, photos: [], days: [] });
  const week = weeks.at(-1)!;
  week.photos.push(photo);
  if (!week.days.includes(photo.date)) week.days.push(photo.date);
}
---

{
  weeks.map((week) => (
    <section class="wall__week">
      <h2 class="wall__span">
        <time datetime={week.start}>{span(week.start, add(week.start, 6))}</time>
        <small>{week.photos.length} {week.photos.length === 1 ? 'photo' : 'photos'}</small>
      </h2>

      <p class="wall__days">
        {week.days.map((date) => (
          <a href={`/diary#${date}`}>
            <time datetime={date}>{part(date, { weekday: 'short', day: 'numeric' })}</time>
          </a>
        ))}
      </p>

      <ul class="wall">
        {week.photos.map((photo, i) => (
          <li class="wall__item" style={`--tilt:${(i % 3) - 1}deg`}>
            <a
              class="shot__link"
              href={`/photos/${photo.month}/${photo.id}.webp`}
              data-zoom={`/photos/${photo.month}/${photo.id}.webp`}
              data-zoom-srcset={`/photos/${photo.month}/${photo.id}.webp ${photo.width}w`}
              data-zoom-w={photo.width}
              data-zoom-h={photo.height}
              data-caption={day(photo.date)}
              data-alt={`Run Baby Run, ${day(photo.date)}`}
              aria-label={`Open photo from ${day(photo.date)}`}
            >
              <img
                src={`/photos/${photo.month}/${photo.id}-t.webp`}
                alt={`Run Baby Run, ${day(photo.date)}`}
                width={photo.width}
                height={photo.height}
                style={`aspect-ratio:${photo.width}/${photo.height}`}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .wall__week {
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .wall__span {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.75rem;
    margin: 0 0 0.45rem;
    font-size: clamp(1rem, 2.6vw, 1.25rem);
  }

  /* The days inside the week, each into the diary. Small, because the week is
     the heading here and these are a way back to a particular evening. */
  .wall__days {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.9rem;
  }

  .wall__days a {
    text-decoration: none;
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.2rem 0.55rem;
    border: 2px solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
  }

  .wall__days a:hover,
  .wall__days a:focus-visible {
    background: var(--pink);
  }

  .wall__span small {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  /* A mosaic, not a grid: every photograph keeps its own proportions, so
     portraits are tall and the wide ones are wide. Columns rather than grid
     because the number of columns then follows the width on its own, with no
     media queries and no JavaScript — and because a masonry column packs with
     no gaps under the short photos, which a row-based layout cannot.

     The trade is reading order, which runs down each column rather than
     across. Within a single day — which is all any one of these is — that is
     not something anybody reads as wrong. */
  .wall {
    columns: clamp(150px, 21vw, 240px);
    column-gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .wall__item {
    /* Both are needed: break-inside for the modern engines, and a zero-height
       inline-block wrapper is not an option here because the tilt needs a
       block box. A photograph split across two columns is the failure mode. */
    break-inside: avoid;
    page-break-inside: avoid;
    margin: 0 0 0.6rem;
  }

  .wall__item a {
    display: block;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--cream);
    box-shadow: var(--shadow-sm);
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.18s ease;
  }

  .wall__item a:hover,
  .wall__item a:focus-visible {
    transform: rotate(0deg) translate(-2px, -2px);
  }

  /* The aspect-ratio is set inline from the photograph's own dimensions, so
     the mosaic is laid out correctly before a single image has loaded and
     nothing shifts underneath the reader as they arrive. */
  .wall__item img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .wall__item a {
      transform: none;
      transition: none;
    }
  }
</style>
