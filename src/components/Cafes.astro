---
/**
 * The two coffee stops on the route — Coffee House, then Prépa under its red
 * awning — plus someone out front with an iced coffee, which is where most of
 * the club ends up afterwards.
 *
 * Scenery: drawn behind the figures and a shade lighter, so it sets the street
 * without competing with the run.
 */

const ink = '#141414';
const cream = '#f7f6f4';
const tuff = '#e3d2c1';
const tuffPink = '#dcc6bd';
const red = '#e01f26';
const prepaRed = '#c8402f';
const dark = '#1d1d1d';
const glass = '#cfdfe4';
const awning = '#eae2d2';
const skin = '#f7e2cf';
const cupPlastic = '#eef3f5';
const cupCream = '#f0e2cf';
const coffee = '#6b4327';
const wood = '#cfa06a';
const woodDark = '#a67c47';
const tomato = '#d94a3d';
const pepperGreen = '#7fa96a';
const bloom = '#d98fa8';
const bloomDeep = '#a35470';
const orange = '#e8622a';
const ivy = '#4a6b3f';
const ivyLight = '#6f8f5c';
const interior = '#f0d9b0';
const peachTea = '#f0a54e';
const steel = '#c9ced2';
const steelDark = '#9aa3a8';
const menuDark = '#14181a';
const canopy = '#3a3f42';
const signRed = '#d2322c';
---

<svg class="cafes" viewBox="0 0 430 200" role="img" aria-label="Coffee House and Prépa">
  <!-- ============ COFFEE HOUSE ============ -->
  <rect x="2" y="6" width="200" height="184" fill={tuffPink} stroke={ink} stroke-width="4" />

  <!-- Ivy over the facade. Two overlapping rows with varied radii, so it
       reads as a mass of leaves rather than a string of beads. -->
  <g>
    {
      [
        [6, 20, 13], [16, 12, 10], [27, 20, 12], [38, 11, 9], [48, 21, 13],
        [60, 13, 10], [71, 22, 11], [82, 12, 9], [93, 20, 12], [104, 12, 10],
        [116, 21, 13], [127, 11, 9], [138, 20, 12], [150, 13, 10], [161, 21, 11],
        [172, 11, 9], [183, 20, 13], [194, 13, 10],
        [10, 33, 10], [30, 31, 8], [55, 34, 9], [88, 32, 8], [120, 33, 9],
        [155, 31, 8], [188, 34, 10],
        [7, 47, 11], [14, 62, 9], [6, 76, 10], [16, 90, 8],
        [197, 48, 11], [190, 63, 9], [198, 78, 10], [188, 93, 8],
      ].map(([cx, cy, r], i) => (
        <circle cx={cx} cy={cy} r={r} fill={i % 2 ? ivy : ivyLight} />
      ))
    }
  </g>

  <!-- projecting sign: the cup mark and the wordmark, as on the shop -->
  <path d="M18 30 L18 46" stroke={ink} stroke-width="4" stroke-linecap="round" />
  <rect x="18" y="22" width="86" height="34" rx="3" fill={dark} stroke={ink} stroke-width="4" />
  <!-- tapered cup -->
  <path d="M26 28 L44 28 L41 50 L29 50 Z" fill={red} />
  <!-- flame -->
  <path d="M35 33 Q39 37 36 41 Q33 44 35 46 Q31 44 32 40 Q33 36 35 33 Z" fill={cream} />
  <text
    x="50"
    y="38"
    fill={cream}
    font-family="'Baloo 2', system-ui, sans-serif"
    font-size="11"
    font-weight="800"
  >COFFEE</text>
  <text
    x="50"
    y="50"
    fill={cream}
    font-family="'Baloo 2', system-ui, sans-serif"
    font-size="11"
    font-weight="800"
  >HOUSE</text>

  <!-- awning, angled out over the pavement -->
  <path
    d="M10 78 L188 70 L192 96 L14 104 Z"
    fill={awning}
    stroke={ink}
    stroke-width="4"
    stroke-linejoin="round"
  />

  <!-- the doorway: warm light inside, the counter and someone behind it, and
       the red neon strips down either side of the reveal -->
  <rect x="18" y="108" width="58" height="74" fill={interior} stroke={ink} stroke-width="4" />
  <rect x="26" y="146" width="42" height="12" rx="2" fill="#b9bec2" stroke={ink} stroke-width="3" />
  <circle cx="47" cy="132" r="7" fill={ink} />
  <path d="M40 146 L40 139 Q47 134 54 139 L54 146 Z" fill={ink} />
  <path d="M14 106 L14 182 M80 106 L80 182" stroke={red} stroke-width="5" stroke-linecap="round" />

  <rect x="92" y="108" width="94" height="58" fill={glass} stroke={ink} stroke-width="4" />

  <!-- ============ PRÉPA ============ -->
  <!-- Drawn from the real frontage: a service window under a dark canopy with
       the menu board above it and a steel counter below, the wordmark on the
       wall rather than on an awning, and the produce crates and the old
       weighing scale out on the pavement. -->
  <rect x="218" y="14" width="210" height="176" fill={tuff} stroke={ink} stroke-width="4" />

  <!-- wordmark, high on the wall to the right -->
  <text
    x="420"
    y="38"
    fill={cream}
    font-family="'Baloo 2', system-ui, sans-serif"
    font-size="17"
    font-weight="800"
    text-anchor="end"
    letter-spacing="1.5"
  >PRÉPA</text>

  <!-- the glass door on the left, pastry case inside -->
  <rect x="224" y="72" width="46" height="110" fill={dark} stroke={ink} stroke-width="3.5" />
  <rect x="229" y="78" width="36" height="98" fill={interior} />
  <rect x="232" y="116" width="30" height="30" fill={cream} stroke={ink} stroke-width="2" />
  <path d="M232 126 L262 126 M232 136 L262 136" stroke={woodDark} stroke-width="1.6" />
  <path d="M247 72 L247 182" stroke={ink} stroke-width="2.5" />

  <!-- canopy over the window -->
  <rect x="266" y="46" width="162" height="13" fill={canopy} stroke={ink} stroke-width="3" />

  <!-- the service window -->
  <rect x="270" y="59" width="156" height="92" fill={menuDark} stroke={ink} stroke-width="3.5" />

  <!-- menu board: three columns of items and prices. Drawn as bars rather
       than type — at the size this renders on the page, real text would be a
       grey smudge, and bars read as a menu at any size. -->
  <rect x="274" y="63" width="148" height="27" fill="#0d1012" />
  {
    [0, 1, 2].map((col) =>
      [0, 1, 2, 3].map((row) => (
        <>
          <rect x={278 + col * 49} y={67 + row * 5.4} width={20 - (row % 3) * 3} height="2.4" fill={cream} opacity="0.86" />
          <rect x={310 + col * 49} y={67 + row * 5.4} width="9" height="2.4" fill={cream} opacity="0.55" />
        </>
      ))
    )
  }

  <!-- the opening, and what is going on behind it -->
  <rect x="274" y="92" width="148" height="33" fill={interior} />
  <!-- coffee machine -->
  <rect x="336" y="99" width="28" height="21" fill={steelDark} stroke={ink} stroke-width="2" />
  <path d="M343 120 L343 113 M357 120 L357 113" stroke={ink} stroke-width="2" />
  <circle cx="350" cy="105" r="3.5" fill={cream} stroke={ink} stroke-width="1.6" />
  <!-- cups stacked beside it -->
  <rect x="370" y="108" width="7" height="12" fill={cream} stroke={ink} stroke-width="1.6" />
  <rect x="380" y="108" width="7" height="12" fill={cream} stroke={ink} stroke-width="1.6" />
  <!-- the barista -->
  <circle cx="400" cy="102" r="6.5" fill={skin} stroke={ink} stroke-width="2.2" />
  <path d="M392 125 Q392 110 400 110 Q408 110 408 125 Z" fill={cream} stroke={ink} stroke-width="2.2" stroke-linejoin="round" />

  <!-- FROZEN YOGURT, in red on the counter end -->
  <rect x="279" y="97" width="36" height="23" rx="3" fill={signRed} stroke={ink} stroke-width="2.2" />
  <rect x="284" y="103" width="26" height="3" fill={cream} />
  <rect x="284" y="109" width="20" height="3" fill={cream} />

  <!-- steel counter -->
  <rect x="266" y="125" width="162" height="26" fill={steel} stroke={ink} stroke-width="3.5" />
  <path d="M268 133 L426 133" stroke={steelDark} stroke-width="2.5" />

  <!-- one person at the counter, back to us -->
  <circle cx="352" cy="149" r="6.5" fill={skin} stroke={ink} stroke-width="2.4" />
  <path d="M343 182 Q343 157 352 157 Q361 157 361 182 Z" fill="#5b93c4" stroke={ink} stroke-width="2.4" stroke-linejoin="round" />

  <!-- the chairs out front, which is where the club ends up. Rounded backs,
       drawn ink-first then orange over it, so the outline stays heavy at the
       size this renders. -->
  <g>
    <g stroke={ink} stroke-width="10" stroke-linecap="round" fill="none">
      <path d="M300 176 L300 160" />
      <path d="M296 160 Q304 153 312 160" />
    </g>
    <g stroke={orange} stroke-width="6" stroke-linecap="round" fill="none">
      <path d="M300 176 L300 160" />
      <path d="M296 160 Q304 153 312 160" />
    </g>
    <path d="M297 184 L297 174 M308 174 L308 184" stroke={ink} stroke-width="3.2" stroke-linecap="round" />

    <rect x="314" y="158" width="34" height="10" rx="5" fill={orange} stroke={ink} stroke-width="3.4" />
    <path d="M326 184 L340 184" stroke={ink} stroke-width="3.4" stroke-linecap="round" />
    <path d="M331 168 L331 184" stroke={ink} stroke-width="3.4" />

    <g stroke={ink} stroke-width="10" stroke-linecap="round" fill="none">
      <path d="M362 176 L362 160" />
      <path d="M358 160 Q366 153 374 160" />
    </g>
    <g stroke={orange} stroke-width="6" stroke-linecap="round" fill="none">
      <path d="M362 176 L362 160" />
      <path d="M358 160 Q366 153 374 160" />
    </g>
    <path d="M359 184 L359 174 M370 174 L370 184" stroke={ink} stroke-width="3.2" stroke-linecap="round" />
  </g>

  <!-- the old weighing scale, and the crates of produce -->
  <g>
    <rect x="272" y="158" width="26" height="10" fill={cream} stroke={ink} stroke-width="2.4" />
    <circle cx="285" cy="150" r="9" fill={cream} stroke={ink} stroke-width="2.4" />
    <path d="M285 150 L289 145" stroke={ink} stroke-width="2" stroke-linecap="round" />
    <rect x="277" y="168" width="16" height="14" fill={wood} stroke={ink} stroke-width="2.4" />

    <rect x="374" y="158" width="50" height="24" fill={wood} stroke={ink} stroke-width="3.2" />
    <path d="M374 166 L424 166 M374 174 L424 174" stroke={woodDark} stroke-width="2.2" />
    <text
      x="399"
      y="171"
      fill={ink}
      font-family="'Baloo 2', system-ui, sans-serif"
      font-size="7"
      font-weight="800"
      text-anchor="middle"
      opacity="0.55"
    >PRÉPA</text>
    <rect x="380" y="138" width="42" height="20" fill={wood} stroke={ink} stroke-width="3.2" />
    <circle cx="388" cy="133" r="5.5" fill={tomato} stroke={ink} stroke-width="2.2" />
    <circle cx="399" cy="131" r="6" fill={peachTea} stroke={ink} stroke-width="2.2" />
    <circle cx="410" cy="133" r="5.5" fill={pepperGreen} stroke={ink} stroke-width="2.2" />
    <circle cx="394" cy="125" r="5" fill={tomato} stroke={ink} stroke-width="2.2" />
    <circle cx="405" cy="124" r="5" fill={tomato} stroke={ink} stroke-width="2.2" />

    <!-- flowers by the door -->
    <path d="M256 182 L254 168 L270 168 L268 182 Z" fill={cream} stroke={ink} stroke-width="3" stroke-linejoin="round" />
    <circle cx="259" cy="163" r="4.5" fill={bloom} stroke={ink} stroke-width="2.2" />
    <circle cx="267" cy="161" r="4.5" fill={bloomDeep} stroke={ink} stroke-width="2.2" />
  </g>

  <!-- the red-and-white tiled entrance, at the door where it really is -->
  <g>
    {
      Array.from({ length: 7 }, (_, i) => (
        <>
          <rect x={222 + i * 8} y="182" width="8" height="4" fill={i % 2 ? prepaRed : cream} />
          <rect x={222 + i * 8} y="186" width="8" height="4" fill={i % 2 ? cream : prepaRed} />
        </>
      ))
    }
    <path d="M222 182 L278 182 M222 190 L278 190" stroke={ink} stroke-width="2.5" />
  </g>

  <!-- ============ someone with an iced coffee, out front of Prépa ============ -->
  <g
    class="cafes__girl"
    transform="translate(30 0) translate(133 182) scale(1.18) translate(-133 -182)"
  >
    <!-- legs -->
    <path d="M128 182 L128 152" stroke={ink} stroke-width="9" stroke-linecap="round" />
    <path d="M128 182 L128 152" stroke={skin} stroke-width="5" stroke-linecap="round" />
    <path d="M138 182 L138 152" stroke={ink} stroke-width="9" stroke-linecap="round" />
    <path d="M138 182 L138 152" stroke={skin} stroke-width="5" stroke-linecap="round" />
    <!-- shorts and top -->
    <path d="M122 138 L144 138 L144 156 L122 156 Z" fill="#f4e3a8" stroke={ink} stroke-width="3.5" stroke-linejoin="round" />
    <path d="M122 112 L144 112 L145 140 L121 140 Z" fill={cream} stroke={ink} stroke-width="3.5" stroke-linejoin="round" />
    <!-- head, hair, headband -->
    <circle cx="133" cy="100" r="11" fill={skin} stroke={ink} stroke-width="3.5" />
    <path
      d="M122 100 Q122 88 133 88 Q144 88 144 100 L144 116 L140 116 Q139 98 133 98 Q127 98 126 116 L122 116 Z"
      fill={ink}
    />
    <path d="M123 94 L143 94" stroke={cream} stroke-width="4" stroke-linecap="round" />
    <!-- arm holding the cup -->
    <path d="M143 120 L138 132" stroke={ink} stroke-width="8" stroke-linecap="round" />
    <path d="M143 120 L138 132" stroke={skin} stroke-width="4.5" stroke-linecap="round" />
    <!-- A Coffee House iced coffee: clear tumbler, coffee under cream, red
         label. Too small for the wordmark, so the flame carries the brand. -->
    <path d="M129.5 122 L144.5 122 L142 143 L132 143 Z" fill={cupPlastic} />
    <path d="M131 133 L143 133 L142 143 L132 143 Z" fill={coffee} />
    <path d="M129.5 122 L144.5 122 L144 127 L130 127 Z" fill={cupCream} />
    <path
      d="M129.5 122 L144.5 122 L142 143 L132 143 Z"
      fill="none"
      stroke={ink}
      stroke-width="3"
      stroke-linejoin="round"
    />
    <!-- lid -->
    <path d="M128 119 L146 119 L145 123 L129 123 Z" fill={cupCream} stroke={ink} stroke-width="3" stroke-linejoin="round" />
    <!-- label -->
    <rect x="133" y="130" width="9" height="7" rx="1" fill={red} stroke={ink} stroke-width="1.5" />
    <path d="M137.2 131.6 Q138.6 133 137.5 134.3 Q136.6 135.2 137.3 135.8 Q136 135.2 136.4 133.8 Q136.8 132.6 137.2 131.6 Z" fill={cream} />
    <!-- straw -->
    <path d="M139 119 L143 108" stroke={ink} stroke-width="3" stroke-linecap="round" />
  </g>

  <!-- ============ and someone they're talking to, with a Prépa iced tea ==== -->
  <g
    class="cafes__friend"
    transform="translate(202 182) scale(1.18) translate(-202 -182)"
  >
    <!-- legs -->
    <path d="M197 182 L197 152" stroke={ink} stroke-width="9" stroke-linecap="round" />
    <path d="M197 182 L197 152" stroke="#3d3a37" stroke-width="5" stroke-linecap="round" />
    <path d="M207 182 L207 152" stroke={ink} stroke-width="9" stroke-linecap="round" />
    <path d="M207 182 L207 152" stroke="#3d3a37" stroke-width="5" stroke-linecap="round" />
    <!-- shorts and tee -->
    <path d="M191 138 L213 138 L213 156 L191 156 Z" fill="#3d3a37" stroke={ink} stroke-width="3.5" stroke-linejoin="round" />
    <path d="M191 112 L213 112 L214 140 L190 140 Z" fill={prepaRed} stroke={ink} stroke-width="3.5" stroke-linejoin="round" />
    <!-- head, turned towards her -->
    <circle cx="201" cy="100" r="11" fill={skin} stroke={ink} stroke-width="3.5" />
    <path d="M190 99 Q190 88 201 88 Q212 88 212 99 Q206 94 201 94 Q195 94 190 99 Z" fill={ink} />
    <!-- near arm, holding the jar out between them -->
    <path d="M191 120 L186 132" stroke={ink} stroke-width="8" stroke-linecap="round" />
    <path d="M191 120 L186 132" stroke={skin} stroke-width="4.5" stroke-linecap="round" />

    <!-- Prépa peach iced tea: glass jar, cream label, screw lid -->
    <rect x="179" y="124" width="14" height="18" rx="2.5" fill={peachTea} stroke={ink} stroke-width="3" />
    <rect x="180" y="129" width="12" height="8" fill={cupCream} />
    <path d="M182 133.5 L190 133.5" stroke={prepaRed} stroke-width="2" stroke-linecap="round" />
    <rect x="180.5" y="120" width="11" height="5" rx="1.5" fill="#b9bec2" stroke={ink} stroke-width="2.5" />
  </g>
</svg>

<style>
  .cafes {
    width: 100%;
    height: auto;
  }
</style>
