---
const facts = [
  { k: 'Free', v: 'always, for everyone' },
  { k: 'All paces', v: 'from 4:30/km to 8:00/km, same start line' },
  { k: 'No sign-up', v: 'just turn up at the meeting point' },
  { k: 'Coffee after', v: 'the actual reason most of us come' },
];
---

<section class="section club" id="club">
  <div class="wrap club__inner">
    <div class="club__lead">
      <p class="eyebrow">What this actually is</p>
      <h2>A club,<br />not a race.</h2>
      <p class="club__quote">
        “If you can walk out the door, you belong here.”
      </p>
    </div>

    <div class="club__body reveal">
      <p>
        Run Baby Run is a free, open running club in Yerevan. There is no membership, no fee and no
        pace requirement.
      </p>
      <p>
        Every run has a front group and a back group, and nobody gets left behind. Some people come
        to chase a PB, some come because it beats scrolling at 10pm on a Tuesday. Both are the
        correct reason.
      </p>

      <dl class="facts">
        {
          facts.map((fact) => (
            <div class="facts__row">
              <dt>{fact.k}</dt>
              <dd>{fact.v}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .club {
    background: var(--cream-deep);
    border-block: var(--line) solid var(--ink);
  }

  .club__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
  }

  .club__quote {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 2.4vw, 1.625rem);
    line-height: 1.25;
    margin: 2rem 0 0;
    padding-left: 1.25rem;
    border-left: var(--line) solid var(--pink-deep);
    max-width: 22ch;
  }

  .club__body p {
    font-size: 1.125rem;
    max-width: 54ch;
  }

  .facts {
    margin: 2.5rem 0 0;
    display: grid;
    gap: 0;
  }

  .facts__row {
    display: grid;
    grid-template-columns: minmax(8.5rem, auto) 1fr;
    gap: 1rem;
    align-items: baseline;
    padding: 0.9rem 0;
    border-top: 1.5px solid color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .facts__row:last-child {
    border-bottom: 1.5px solid color-mix(in srgb, var(--ink) 20%, transparent);
  }

  .facts dt {
    font-family: var(--font-display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.0625rem;
    letter-spacing: 0.01em;
  }

  .facts dd {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }

  @media (max-width: 860px) {
    .club__inner {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 440px) {
    .facts__row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
