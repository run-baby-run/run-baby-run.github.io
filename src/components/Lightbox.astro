---
/**
 * The photo viewer.
 *
 * It binds to every `.shot__link` on the page, wherever they came from — the
 * gallery grid, a diary entry, a race — so any page that emits those links and
 * drops this component in gets the same viewer, with arrows, swipe and Escape.
 */
---

<script>
  // Re-initialised on every navigation: with client-side routing the body is
  // swapped, so the previous dialog and links are gone.
  function initLightbox() {
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.shot__link'));
    if (links.length === 0) return;

    let dialog: HTMLDialogElement | null = null;
    let img: HTMLImageElement;
    let figure: HTMLElement;
    let caption: HTMLElement;
    let counter: HTMLElement;
    let index = 0;
    let spinTimer: number | undefined;

    /*
     * How long the full photograph may take before the viewer is told it is
     * coming.
     *
     * This was 400ms, borrowed from the navigation bar in Base.astro, and it
     * was the wrong number here. That threshold exists so a fast navigation
     * never flashes a bar — but a navigation shows nothing at all until it
     * lands, whereas this dialog is open and showing the right photograph in
     * 17ms. The wait is not "is anything happening", it is "is this as sharp
     * as it gets". Measured on the live site over a phone profile: dialog at
     * 17ms, sharp at 720ms. A signal that arrived at 416ms missed two thirds
     * of the wait, which is exactly how it felt.
     *
     * 120ms instead, and it fades in over 180ms rather than appearing, so a
     * photograph that lands quickly shows a faint hint rather than a blink.
     */
    const SPIN_AFTER = 120;

    const build = () => {
      const el = document.createElement('dialog');
      el.className = 'lightbox';
      el.innerHTML = `
        <button class="lightbox__close" type="button" aria-label="Close">✕</button>
        <button class="lightbox__nav lightbox__nav--prev" type="button" aria-label="Previous photo">←</button>
        <button class="lightbox__nav lightbox__nav--next" type="button" aria-label="Next photo">→</button>
        <figure class="lightbox__figure">
          <img class="lightbox__img" alt="" />
          <figcaption class="lightbox__caption">
            <span class="lightbox__text"></span>
            <span class="lightbox__count"></span>
          </figcaption>
        </figure>`;
      document.body.append(el);

      img = el.querySelector('.lightbox__img') as HTMLImageElement;
      figure = el.querySelector('.lightbox__figure') as HTMLElement;
      caption = el.querySelector('.lightbox__text') as HTMLElement;
      counter = el.querySelector('.lightbox__count') as HTMLElement;

      el.querySelector('.lightbox__close')!.addEventListener('click', () => el.close());
      el.querySelector('.lightbox__nav--prev')!.addEventListener('click', () => show(index - 1));
      el.querySelector('.lightbox__nav--next')!.addEventListener('click', () => show(index + 1));

      // Clicking the backdrop (but not the photo) closes.
      el.addEventListener('click', (event) => {
        if (event.target === el) el.close();
      });

      // Horizontal swipe on touch devices.
      let startX = 0;
      el.addEventListener(
        'touchstart',
        (event) => {
          startX = event.changedTouches[0].clientX;
        },
        { passive: true }
      );
      el.addEventListener(
        'touchend',
        (event) => {
          const dx = event.changedTouches[0].clientX - startX;
          if (Math.abs(dx) > 45) show(dx < 0 ? index + 1 : index - 1);
        },
        { passive: true }
      );

      el.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          show(index - 1);
        } else if (event.key === 'ArrowRight') {
          event.preventDefault();
          show(index + 1);
        }
      });

      return el;
    };

    const preload = (i: number) => {
      const link = links[(i + links.length) % links.length];
      const img = new Image();
      img.sizes = '96vw';
      img.srcset = link.dataset.zoomSrcset ?? '';
      img.src = link.dataset.zoom!;
    };

    const show = (next: number) => {
      index = (next + links.length) % links.length;
      const link = links[index];

      // Size the element up front from the known dimensions, so the box is
      // correct before any bytes arrive and nothing jumps on load.
      img.width = Number(link.dataset.zoomW) || 0;
      img.height = Number(link.dataset.zoomH) || 0;

      // The grid thumbnail is already decoded in this page, so paint it behind
      // the full image straight away — the dialog is never empty.
      const thumb = link.querySelector('img');
      const placeholder = thumb?.currentSrc || thumb?.src;
      img.style.backgroundImage = placeholder ? `url("${placeholder}")` : '';

      img.classList.add('is-loading');
      img.alt = link.dataset.alt ?? '';
      img.sizes = '96vw';
      img.srcset = link.dataset.zoomSrcset ?? '';
      img.src = link.dataset.zoom!;

      clearTimeout(spinTimer);
      figure.classList.remove('is-waiting');

      const done = () => {
        clearTimeout(spinTimer);
        figure.classList.remove('is-waiting');
        // Also on error: otherwise is-loading keeps the alt text hidden and a
        // photograph that failed to load is an unexplained blank for ever.
        img.classList.remove('is-loading');
      };

      if (img.complete) {
        done();
      } else {
        spinTimer = window.setTimeout(() => figure.classList.add('is-waiting'), SPIN_AFTER);
        img.addEventListener('load', done, { once: true });
        img.addEventListener('error', done, { once: true });
      }

      caption.textContent = link.dataset.caption ?? '';
      counter.textContent = `${index + 1} / ${links.length}`;

      // Arrow navigation should feel instant.
      if (links.length > 1) {
        preload(index + 1);
        preload(index - 1);
      }
    };

    links.forEach((link, i) => {
      // Same reason as the player: this runs on load and on astro:page-load.
      if (link.dataset.lbBound === 'true') return;
      link.dataset.lbBound = 'true';

      link.addEventListener('click', (event) => {
        // Let modified clicks open the image in a new tab as usual.
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
        event.preventDefault();
        dialog ??= build();
        show(i);
        dialog.showModal();
      });
    });

    // A dialog appended to <body> would be left behind by a navigation.
    document.addEventListener(
      'astro:before-swap',
      () => {
        dialog?.close();
        dialog?.remove();
        dialog = null;
      },
      { once: true }
    );
  }

  initLightbox();
  document.addEventListener('astro:page-load', initLightbox);
</script>

<style is:global>
  /* Sized by the photo, so portrait shots do not sit in a letterboxed slab. */
  .lightbox {
    box-sizing: border-box;
    width: fit-content;
    max-width: 96vw;
    max-height: 94vh;
    padding: 0;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: 10px 10px 0 rgba(0, 0, 0, 0.35);
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(10, 10, 10, 0.82);
    backdrop-filter: blur(3px);
  }

  .lightbox__figure {
    position: relative;
    margin: 0;
    display: flex;
    flex-direction: column;
    /* Centre rather than stretch, so the image keeps its intrinsic size and
       the dialog can shrink-to-fit around it. */
    align-items: center;
    max-width: 100%;
    min-width: 0;
    max-height: 94vh;
  }

  .lightbox__img {
    display: block;
    width: auto;
    height: auto;
    min-height: 0;
    /* Bound to the dialog, not the viewport. Against 96vw the image came out
       wider than the 94vw dialog plus its border, and spilled past both edges
       on a phone — which also dragged the caption off the left of the screen. */
    max-width: 100%;
    max-height: calc(94vh - 3.5rem);
    object-fit: contain;
    border-bottom: var(--line) solid var(--ink);
    border-radius: calc(var(--radius) - 3px) calc(var(--radius) - 3px) 0 0;
    /* The cached thumbnail sits behind until the full image decodes. */
    background-color: var(--ink);
    background-position: center;
    background-repeat: no-repeat;
    background-size: cover;
    transition: opacity 0.2s ease;
  }

  /* Until the bitmap arrives the element would paint its alt text (and a
     broken-image glyph) over the placeholder. */
  .lightbox__img.is-loading {
    color: transparent;
    font-size: 0;
  }

  /* The dialog opens on the gallery thumbnail, already decoded, so it is never
     empty — but a 400px thumbnail blown up to fill a phone is only slightly
     soft, and nothing about it says a sharper one is on its way. This does.
     A pseudo-element, so the markup and the careful sizing above are untouched.

     A bar across the top edge of the photograph rather than a ring in the
     corner: a 1.35rem ring was there for 300ms of a 720ms wait, in a corner
     nobody is looking at while they wait for the middle of the picture. This
     is the same language as the navigation bar in Base.astro, and it is
     impossible to miss. It sweeps rather than fills, because there is no
     progress to report — an <img> gives no byte counts. */
  .lightbox__figure.is-waiting::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 3;
    height: 4px;
    border-radius: calc(var(--radius) - 3px) calc(var(--radius) - 3px) 0 0;
    /* A dark rail under the sweep, so it reads over a pale photograph too. */
    background-color: rgba(10, 10, 10, 0.35);
    background-image: linear-gradient(90deg, transparent, var(--pink-deep), transparent);
    background-size: 45% 100%;
    background-repeat: no-repeat;
    animation: lightbox-sweep 1.1s linear infinite, lightbox-fade 0.18s ease-out;
  }

  @keyframes lightbox-sweep {
    from { background-position: -50% 0; }
    to { background-position: 150% 0; }
  }

  /* Fades in rather than appearing, so a photograph that lands in 200ms shows
     a faint hint instead of a blink. */
  @keyframes lightbox-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  /* Still say that something is happening, without the sweep. */
  @media (prefers-reduced-motion: reduce) {
    .lightbox__figure.is-waiting::after {
      background-image: none;
      background-color: var(--pink-deep);
      animation: none;
    }
  }

  .lightbox__caption {
    align-self: stretch;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.35rem 1rem;
    min-width: 0;
    padding: 0.75rem 1.1rem 0.85rem;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9375rem;
  }

  .lightbox__count {
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .lightbox__close,
  .lightbox__nav {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--cream);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1;
    cursor: pointer;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }

  .lightbox__close:hover,
  .lightbox__nav:hover {
    background: var(--pink);
    transform: scale(1.06);
  }

  .lightbox__close {
    top: -1.1rem;
    right: -1.1rem;
  }

  .lightbox__nav {
    top: 50%;
    translate: 0 -50%;
  }

  .lightbox__nav--prev {
    left: -1.35rem;
  }

  .lightbox__nav--next {
    right: -1.35rem;
  }

  @media (max-width: 720px) {
    /* Still shrink to the photo — a landscape shot on a wide phone should not
       sit in a letterboxed slab — but never past the edge of the screen. */
    .lightbox {
      width: fit-content;
      max-width: 94vw;
    }

    .lightbox__caption {
      padding: 0.6rem 0.8rem 0.7rem;
      font-size: 0.8125rem;
    }

    .lightbox__close {
      top: -1rem;
      right: -0.6rem;
    }

    .lightbox__nav--prev {
      left: 0.5rem;
    }

    .lightbox__nav--next {
      right: 0.5rem;
    }

    .lightbox__nav {
      background: color-mix(in srgb, var(--cream) 88%, transparent);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__close,
    .lightbox__nav {
      transition: none;
    }
  }
</style>
