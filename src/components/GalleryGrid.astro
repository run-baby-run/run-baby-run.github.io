---
import { Image, getImage } from 'astro:assets';
import type { ResolvedShot } from '../data/gallery';
import Lightbox from './Lightbox.astro';

interface Props {
  shots: ResolvedShot[];
  /** Index of the first shot on this page, so tilts stay varied across pages. */
  offset?: number;
}

const { shots, offset = 0 } = Astro.props;

// Zoom renditions. A phone should not download a desktop-sized photo, so this
// is a srcset rather than one fixed size, and it is only fetched on open.
const zoomed = await Promise.all(
  shots.map(async (shot) => {
    const widths = [...new Set([800, 1200, Math.min(1600, shot.image.width)])]
      .filter((w) => w <= shot.image.width)
      .sort((a, b) => a - b);

    const renditions = await Promise.all(
      widths.map((width) =>
        getImage({ src: shot.image, width, format: 'webp', quality: 68 })
      )
    );

    const largest = renditions[renditions.length - 1];
    return {
      src: largest.src,
      srcset: renditions.map((r, i) => `${r.src} ${widths[i]}w`).join(', '),
      width: widths[widths.length - 1],
      height: Math.round((widths[widths.length - 1] / shot.image.width) * shot.image.height),
    };
  })
);
---

<ul class="gallery">
  {
    shots.map((shot, i) => {
      const n = offset + i;
      return (
        <li class={`shot reveal${shot.tall ? ' shot--tall' : ''}`} style={`--tilt:${(n % 3) - 1}deg`}>
          <figure>
            {/* Without JS this is just a link to the larger image. */}
            <a
              class="shot__link"
              href={zoomed[i].src}
              data-zoom={zoomed[i].src}
              data-zoom-srcset={zoomed[i].srcset}
              data-zoom-w={zoomed[i].width}
              data-zoom-h={zoomed[i].height}
              data-caption={shot.caption}
              data-alt={shot.alt}
              aria-label={`Open photo: ${shot.caption}`}
            >
              <Image
                src={shot.image}
                alt={shot.alt}
                width={800}
                widths={[360, 550, 800]}
                quality={58}
                sizes="(max-width: 640px) 92vw, (max-width: 1000px) 46vw, 32vw"
                loading="lazy"
                decoding="async"
              />
              <span class="shot__zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <circle cx="10.5" cy="10.5" r="6.5" />
                  <path d="M15.5 15.5 21 21M10.5 7.5v6M7.5 10.5h6" />
                </svg>
              </span>
            </a>
            <figcaption>{shot.caption}</figcaption>
          </figure>
        </li>
      );
    })
  }
</ul>

<Lightbox />

<style>
  /* Columns rather than grid: portrait and landscape shots pack without
     leaving holes, at the cost of column-wise reading order. */
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 300px;
    column-gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  .shot {
    break-inside: avoid;
    margin-bottom: clamp(1.25rem, 3vw, 2.25rem);
    rotate: var(--tilt);
    transition: rotate 0.3s ease, transform 0.3s ease;
  }

  .shot:hover {
    rotate: 0deg;
    transform: translateY(-4px);
  }

  .shot figure {
    margin: 0;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    background: var(--cream);
    overflow: hidden;
  }

  .shot__link {
    display: block;
    position: relative;
    cursor: zoom-in;
  }

  .shot img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-bottom: var(--line) solid var(--ink);
  }

  .shot--tall img {
    aspect-ratio: 3 / 4;
  }

  .shot__zoom {
    position: absolute;
    right: 0.65rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: var(--line) solid var(--ink);
    border-radius: 50%;
    background: var(--pink);
    color: var(--ink);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .shot__link:hover .shot__zoom,
  .shot__link:focus-visible .shot__zoom {
    opacity: 1;
    transform: none;
  }

  .shot figcaption {
    padding: 0.7rem 1rem 0.85rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
</style>
