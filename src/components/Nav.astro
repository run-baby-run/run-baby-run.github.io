---
import { site } from '../data/site';

interface Props {
  /** Which top-level page is showing, so the nav can mark it. */
  current?: 'home' | 'diary' | 'gallery' | 'races' | 'training' | 'blog' | 'members' | 'leaderboard';
}

const { current = 'home' } = Astro.props;

/**
 * Five in the bar and three behind a button.
 *
 * There is room for about 41 characters of label at a comfortable size on a
 * 390px phone. Eight links come to 51, which is why they had been shrinking to
 * 12px and getting hard to hit. These five come to 35 and fit at full size; the
 * rest are one tap away here and also listed in the footer, so nothing is only
 * reachable through the button.
 *
 * Absolute hrefs, so the section anchors work from every page.
 */
const primary = [
  { href: '/diary/', label: 'Diary', key: 'diary' },
  { href: '/gallery/', label: 'Gallery', key: 'gallery' },
  { href: '/races/', label: 'Races', key: 'races' },
  { href: '/members/', label: 'Members', key: 'members' },
  { href: '/leaderboard/', label: 'Leaderboard', key: 'leaderboard' },
];

const more = [
  { href: '/#schedule', label: 'Schedule' },
  { href: '/training/', label: 'Training plans', key: 'training' },
  { href: '/blog/', label: 'Running, explained', key: 'blog' },
  { href: '/#club', label: 'About the club' },
];

const mark = (link: { key?: string }) => (link.key === current ? 'is-current' : '');
---

<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/">Run Baby Run</a>

    <nav class="nav__links" aria-label="Main">
      {
        primary.map((link) => (
          <a href={link.href} class={mark(link)} aria-current={link.key === current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__end">
      <!-- Without JavaScript this button does nothing useful, so it is hidden
           until the script claims it and the extra links stay in the open. -->
      <button
        class="nav__more-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-more"
        hidden
        data-nav-toggle
      >
        <span class="nav__bars" aria-hidden="true">
          <span></span><span></span><span></span>
        </span>
        <span class="nav__more-label">More</span>
      </button>

      <a class="btn nav__cta" href={site.whatsapp} target="_blank" rel="noopener">Join us</a>
    </div>

    <div class="nav__more" id="nav-more" data-nav-panel>
      {
        more.map((link) => (
          <a href={link.href} class={mark(link)} aria-current={link.key === current ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</header>

<script>
  /**
   * The "More" button. Progressive enhancement: the panel ships open and the
   * button ships hidden, and this turns that round, so without JavaScript the
   * extra links are simply part of the header.
   */
  function initNav() {
    const nav = document.querySelector<HTMLElement>('[data-nav]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    if (!nav || !toggle) return;

    toggle.hidden = false;
    nav.classList.add('nav--has-toggle');

    const set = (open: boolean) => {
      nav.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    };

    // Re-run on every navigation, but bind the listeners only once.
    if (nav.dataset.bound === 'true') {
      set(false);
      return;
    }
    nav.dataset.bound = 'true';

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      set(!nav.classList.contains('is-open'));
    });

    // A link in the panel should close it — the anchors go to a section of the
    // page already on screen, so nothing else would.
    nav.querySelector('[data-nav-panel]')?.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) set(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.classList.contains('is-open')) {
        set(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node)) set(false);
    });
  }

  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--cream) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: var(--line) solid var(--ink);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.7rem;
  }

  .nav__brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1rem, 2.6vw, 1.25rem);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-decoration: none;
    /* Both of these must never wrap: the wordmark reads as two lines and the
       pill CTA collapses into a blob if they do. */
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.65rem, 2.2vw, 2rem);
    font-weight: 500;
  }

  .nav__links a {
    position: relative;
    text-decoration: none;
    padding-block: 0.25rem;
    white-space: nowrap;
    /* Five labels come to 35 characters, which fits at a readable size on a
       320px phone. That is the whole reason there are five. */
    font-size: clamp(0.8125rem, 4.1vw, 1.0625rem);
  }

  /* Underline grows from the left on hover, and stays put on the current page. */
  .nav__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2.5px;
    width: 100%;
    background: var(--pink-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .nav__links a:hover::after,
  .nav__links a.is-current::after {
    transform: scaleX(1);
  }

  .nav__end {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-left: auto;
    flex: none;
  }

  .nav__more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem;
    border: var(--line) solid var(--ink);
    border-radius: 999px;
    background: var(--cream);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav__more-toggle:hover {
    background: var(--pink);
  }

  .nav__bars {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .nav__bars span {
    display: block;
    width: 1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--ink);
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  /* Into an X, so the button says what pressing it again does. */
  .nav.is-open .nav__bars span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .nav.is-open .nav__bars span:nth-child(2) {
    opacity: 0;
  }

  .nav.is-open .nav__bars span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  .nav__cta {
    padding: 0.6rem 1.1rem;
    font-size: clamp(0.75rem, 2.4vw, 0.9375rem);
    box-shadow: 3px 3px 0 var(--ink);
    white-space: nowrap;
    flex: none;
  }

  /* The panel. Open by default so that it is there without JavaScript; the
     script collapses it and reveals the button. */
  .nav__more {
    display: flex;
    gap: clamp(0.65rem, 2.2vw, 1.5rem);
    font-weight: 500;
  }

  .nav__more a {
    text-decoration: none;
    font-size: 0.9375rem;
    white-space: nowrap;
  }

  .nav__more a:hover,
  .nav__more a.is-current {
    text-decoration: underline;
    text-decoration-color: var(--pink-deep);
    text-decoration-thickness: 2.5px;
    text-underline-offset: 4px;
  }

  .nav--has-toggle .nav__more {
    position: absolute;
    right: clamp(0.85rem, 3vw, 1.5rem);
    top: calc(100% - 0.35rem);
    z-index: 31;
    flex-direction: column;
    gap: 0;
    min-width: 12.5rem;
    padding: 0.35rem 0;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    background: var(--cream);
    box-shadow: var(--shadow-sm);
    display: none;
  }

  .nav--has-toggle.is-open .nav__more {
    display: flex;
  }

  .nav--has-toggle .nav__more a {
    padding: 0.6rem 1rem;
  }

  .nav--has-toggle .nav__more a:hover,
  .nav--has-toggle .nav__more a.is-current {
    background: var(--pink);
    text-decoration: none;
  }

  /* The panel is positioned against the header, not the page. */
  .nav {
    position: sticky;
  }

  .nav__inner {
    position: relative;
  }

  /* Below this the five links take a row of their own, under the brand. */
  @media (max-width: 860px) {
    .nav__inner {
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-block: 0.6rem;
    }

    .nav__links {
      order: 3;
      width: 100%;
      justify-content: space-between;
      gap: 0.4rem;
      padding-top: 0.5rem;
      border-top: 1.5px solid color-mix(in srgb, var(--ink) 14%, transparent);
    }

    .nav--has-toggle .nav__more {
      top: calc(100% - 0.3rem);
    }
  }

  @media (max-width: 420px) {
    .nav__more-toggle {
      padding: 0.35rem 0.6rem;
      font-size: 0.75rem;
    }

    .nav__more-label {
      display: none;
    }

    .nav__cta {
      padding: 0.5rem 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav__links a::after,
    .nav__bars span {
      transition: none;
    }
  }
</style>
