---
import { site } from '../data/site';

interface Props {
  /** Which top-level page is showing, so the nav can mark it. */
  current?: 'home' | 'diary' | 'gallery' | 'races' | 'training' | 'blog' | 'members' | 'leaderboard';
}

const { current = 'home' } = Astro.props;

// Absolute hrefs so the section anchors also work from /gallery.
const links = [
  { href: '/#schedule', label: 'Schedule' },
  { href: '/diary/', label: 'Diary', key: 'diary' },
  { href: '/gallery/', label: 'Gallery', key: 'gallery' },
  { href: '/races/', label: 'Races', key: 'races' },
  { href: '/training/', label: 'Training', key: 'training' },
  { href: '/blog/', label: 'Explained', key: 'blog' },
  { href: '/members/', label: 'Members', key: 'members' },
  { href: '/leaderboard/', label: 'Leaderboard', key: 'leaderboard' },
];
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/">Run Baby Run</a>
    <nav class="nav__links">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={[link.href.startsWith('/#') && 'nav__anchor', link.key === current && 'is-current']
              .filter(Boolean)
              .join(' ')}
            aria-current={link.key === current ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="btn nav__cta" href={site.whatsapp} target="_blank" rel="noopener">Join us</a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--cream) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: var(--line) solid var(--ink);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }

  .nav__brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-decoration: none;
    /* Both of these must never wrap: the wordmark reads as two lines and the
       pill CTA collapses into a blob if they do. */
    white-space: nowrap;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.6vw, 2rem);
    font-weight: 500;
  }

  .nav__links a:not(.btn) {
    position: relative;
    text-decoration: none;
    padding-block: 0.25rem;
  }

  /* Underline grows from the left on hover, and stays put on the current page. */
  .nav__links a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2.5px;
    width: 100%;
    background: var(--pink-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .nav__links a:not(.btn):hover::after,
  .nav__links a.is-current::after {
    transform: scaleX(1);
  }

  .nav__cta {
    padding: 0.55rem 1.25rem;
    font-size: 0.9375rem;
    box-shadow: 3px 3px 0 var(--ink);
    white-space: nowrap;
    flex: none;
  }

  @media (max-width: 720px) {
    /* Section anchors are dropped on small screens; the real pages stay. */
    .nav__anchor {
      display: none;
    }
    .nav__brand {
      font-size: 1.125rem;
    }
  }

  /* Phone widths: with five destinations the links no longer fit beside the
     CTA, so they wrap onto their own row rather than running off the edge. */
  /* The links drop to their own full-width row well before a phone. With seven
     of them — eight, since the blog — brand, links and CTA stop fitting on one
     line at about 1100px. Measured, not guessed: 1024 was pushing the "Join us"
     button off the edge. */
  @media (max-width: 1120px) {
    .nav__inner {
      flex-wrap: wrap;
      gap: 0.5rem;
      padding-block: 0.6rem;
    }

    .nav__brand {
      font-size: 1rem;
    }

    /*
     * One row, always. Six links show at this width (Schedule is hidden) and
     * they come to about 326px at the old size, in 350px of room on a 390px
     * phone — so they wrapped, and "Leaderboard" sat alone on a second line.
     *
     * They shrink to fit instead of wrapping or hiding behind a button: the
     * size and the gap both scale with the viewport, so the row stays one line
     * from 320px up and nothing is put out of reach.
     */
    .nav__links {
      order: 3;
      width: 100%;
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: clamp(0.2rem, 1.1vw, 0.9rem);
      padding-top: 0.5rem;
      border-top: 1.5px solid color-mix(in srgb, var(--ink) 14%, transparent);
      /* The safety net. The row shrinks to fit at any width worth having, but
         on a 320px phone with eight links it is a couple of pixels over — so it
         scrolls rather than clipping, and nothing is ever out of reach. */
      overflow-x: auto;
      scrollbar-width: none;
    }

    .nav__links::-webkit-scrollbar {
      display: none;
    }

    .nav__links a:not(.btn) {
      font-size: clamp(0.625rem, 2.7vw, 0.875rem);
      white-space: nowrap;
    }

    .nav__cta {
      padding: 0.5rem 0.9rem;
      font-size: 0.8125rem;
      box-shadow: 2px 2px 0 var(--ink);
    }
  }

  /* Very narrow phones: trim the row padding too, or the CTA runs off. */
  @media (max-width: 380px) {
    .nav__inner {
      padding-inline: 0.85rem;
    }

    .nav__brand {
      font-size: 0.9375rem;
    }

    /* No font-size or gap here: both scale with the viewport in the rule
       above, and pinning them at this width is what pushed "Leaderboard" off
       the end of the row. */
    .nav__cta {
      padding: 0.45rem 0.75rem;
      font-size: 0.75rem;
    }
  }
</style>
