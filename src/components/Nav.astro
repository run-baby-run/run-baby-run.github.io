---
import { site } from '../data/site';

interface Props {
  /** Which top-level page is showing, so the nav can mark it. */
  current?: 'home' | 'gallery';
}

const { current = 'home' } = Astro.props;

// Absolute hrefs so the section anchors also work from /gallery.
const links = [
  { href: '/#schedule', label: 'Schedule' },
  { href: '/#club', label: 'The club' },
  { href: '/gallery/', label: 'Gallery', key: 'gallery' },
  { href: '/#founders', label: 'Founders' },
];
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__brand" href="/">Run Baby Run</a>
    <nav class="nav__links">
      {
        links.map((link) => (
          <a
            href={link.href}
            class={[link.href.startsWith('/#') && 'nav__anchor', link.key === current && 'is-current']
              .filter(Boolean)
              .join(' ')}
            aria-current={link.key === current ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a class="btn nav__cta" href={site.whatsapp} target="_blank" rel="noopener">Join us</a>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in srgb, var(--cream) 85%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: var(--line) solid var(--ink);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
  }

  .nav__brand {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.25rem;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2.6vw, 2rem);
    font-weight: 500;
  }

  .nav__links a:not(.btn) {
    position: relative;
    text-decoration: none;
    padding-block: 0.25rem;
  }

  /* Underline grows from the left on hover, and stays put on the current page. */
  .nav__links a:not(.btn)::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2.5px;
    width: 100%;
    background: var(--pink-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s ease;
  }

  .nav__links a:not(.btn):hover::after,
  .nav__links a.is-current::after {
    transform: scaleX(1);
  }

  .nav__cta {
    padding: 0.55rem 1.25rem;
    font-size: 0.9375rem;
    box-shadow: 3px 3px 0 var(--ink);
  }

  @media (max-width: 720px) {
    /* Section anchors are dropped on small screens; the Gallery page stays. */
    .nav__anchor {
      display: none;
    }
    .nav__brand {
      font-size: 1.125rem;
    }
  }
</style>
