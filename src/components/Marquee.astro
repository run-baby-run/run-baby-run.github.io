---
interface Props {
  items: string[];
  tone?: 'pink' | 'sage' | 'ink';
  reverse?: boolean;
}

const { items, tone = 'pink', reverse = false } = Astro.props;
// The track is rendered twice so the loop can translate by exactly -50%.
const track = [...items, ...items];
---

<div class={`marquee marquee--${tone}`} aria-hidden="true">
  <div class={`marquee__track${reverse ? ' marquee__track--reverse' : ''}`}>
    {
      track.map((item) => (
        <span class="marquee__item">
          {item}
          <span class="marquee__star">✳</span>
        </span>
      ))
    }
  </div>
</div>

<style>
  .marquee {
    overflow: hidden;
    border-block: var(--line) solid var(--ink);
    padding-block: 0.7rem;
    user-select: none;
  }

  .marquee--pink {
    background: var(--pink);
  }
  .marquee--sage {
    background: var(--sage);
  }
  .marquee--ink {
    background: var(--ink);
    color: var(--cream);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    animation: slide 38s linear infinite;
  }

  .marquee__track--reverse {
    animation-direction: reverse;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 1.75rem;
    padding-right: 1.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.125rem, 2.4vw, 1.75rem);
    text-transform: uppercase;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .marquee__star {
    font-size: 0.7em;
    opacity: 0.55;
  }

  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__track {
      animation: none;
    }
  }
</style>
