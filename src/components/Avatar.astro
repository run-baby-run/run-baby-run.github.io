---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  image?: ImageMetadata;
  /** Rendered size in px; the file is generated at twice this for retina. */
  size?: number;
  class?: string;
}

const { name, image, size = 28, class: className } = Astro.props;
const initial = name.trim().charAt(0).toUpperCase();
---

{
  image ? (
    <Image
      class:list={['avatar', className]}
      src={image}
      alt=""
      width={size * 2}
      height={size * 2}
      quality={70}
      loading="lazy"
      decoding="async"
      style={`--size:${size}px`}
    />
  ) : (
    /* Nobody without a photo should leave a hole in the row. */
    <span class:list={['avatar avatar--blank', className]} style={`--size:${size}px`} aria-hidden="true">
      {initial}
    </span>
  )
}

<style>
  .avatar {
    width: var(--size);
    height: var(--size);
    flex: none;
    border-radius: 50%;
    border: 2px solid var(--ink);
    object-fit: cover;
    background: var(--cream);
  }

  .avatar--blank {
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: calc(var(--size) * 0.44);
    line-height: 1;
    background: var(--sage);
    color: var(--ink);
  }
</style>
