---
/**
 * What the club is, in the form a search engine reads.
 *
 * Without this a search engine has to infer from prose that this is a running
 * club in Yerevan; with it, that is stated — the name, the city, the coordinates
 * of the meeting point, that it is free, when it runs, and which other profiles
 * are the same club.
 *
 * Only on the home page: repeating an organisation on every page tells a
 * crawler nothing new.
 */
import { site, runs } from '../data/site';

const url = 'https://runbabyrun.fun';

/** Saryan street, where the Tuesday and Thursday runs start. */
const meetingPoint = { latitude: 40.1858, longitude: 44.5045 };

/*
 * Concrete dates for the weekly runs.
 *
 * These used to be one SportsEvent per run carrying an `eventSchedule` of type
 * Schedule — which is the correct schema.org way to say "every Tuesday at
 * 22:00", and which Google's Event parser does not accept. It wants a real
 * `startDate` on every event, so Search Console reported all three as errors
 * and the schedule never appeared in search at all.
 *
 * So each run is expanded into its next WEEKS_AHEAD dated occurrences at build
 * time. That means the markup goes stale if the site is not rebuilt, which is
 * why .github/workflows/deploy.yml now also runs on a weekly schedule: a build
 * every Monday against six weeks of dates leaves at least five weeks in the
 * future at all times.
 */
const WEEKS_AHEAD = 6;

/* Armenia has not observed daylight saving since 2012, so Asia/Yerevan is a
   fixed +04:00 — verified across all twelve months of 2026. That is what makes
   the arithmetic below safe: no zone library, and no hour that shifts under a
   date computed on a UTC build machine. */
const TZ = '+04:00';
const DAYS = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

const pad = (n: number) => String(n).padStart(2, '0');

/** A Date holding Yerevan wall-clock in its UTC fields, as a local ISO string. */
const stamp = (d: Date) =>
  `${d.getUTCFullYear()}-${pad(d.getUTCMonth() + 1)}-${pad(d.getUTCDate())}` +
  `T${pad(d.getUTCHours())}:${pad(d.getUTCMinutes())}:00${TZ}`;

/** The next `count` occurrences of a weekday at a time, start and end. */
function occurrences(day: string, time: string, minutes: number, count: number) {
  const [h, m] = time.split(':').map(Number);
  // Read the build instant as a Yerevan wall clock, then do everything in UTC
  // getters so the machine's own zone never enters into it.
  const now = new Date(Date.now() + 4 * 3600_000);
  const target = DAYS.indexOf(day);

  const first = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate(), h, m));
  let ahead = (target - first.getUTCDay() + 7) % 7;
  // Today, but the run has already set off: start from next week instead.
  if (ahead === 0 && first.getTime() <= now.getTime()) ahead = 7;
  first.setUTCDate(first.getUTCDate() + ahead);

  return Array.from({ length: count }, (_, i) => {
    const start = new Date(first);
    start.setUTCDate(start.getUTCDate() + i * 7);
    // Adding minutes rolls the date over on its own, which is what the Tuesday
    // night run needs: 22:00 plus an hour is 23:00, but a later start would
    // land on the following day and must say so.
    const end = new Date(start.getTime() + minutes * 60_000);
    return { startDate: stamp(start), endDate: stamp(end) };
  });
}

const club = {
  '@context': 'https://schema.org',
  '@type': 'SportsClub',
  '@id': `${url}/#club`,
  name: `${site.name} Club`,
  alternateName: [site.name, 'Run Baby Run Yerevan', 'Run Baby Run running club'],
  description:
    'A free running club in Yerevan, Armenia. Three runs a week, all paces, no fee and no membership — just show up.',
  slogan: site.tagline,
  url,
  logo: `${url}/images/logo.png`,
  image: `${url}/images/logo.jpg`,
  foundingDate: '2026-02-12',
  isAccessibleForFree: true,
  publicAccess: true,
  sport: 'Running',
  areaServed: { '@type': 'City', name: 'Yerevan', addressCountry: 'AM' },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Yerevan',
    addressCountry: 'AM',
  },
  geo: { '@type': 'GeoCoordinates', ...meetingPoint },
  sameAs: [site.instagram, site.strava],
  // The weekly runs, so the schedule can be read rather than inferred from a
  // table — one entry per dated occurrence, newest build wins.
  event: runs.flatMap((run) =>
    occurrences(run.day, run.time, run.minutes, WEEKS_AHEAD).map(({ startDate, endDate }) => ({
      '@type': 'SportsEvent',
      name: `${site.name} — ${run.label}`,
      description: run.blurb,
      sport: 'Running',
      startDate,
      endDate,
      duration: `PT${run.minutes}M`,
      isAccessibleForFree: true,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      image: [`${url}/images/logo.jpg`, `${url}/video/run-baby-run.jpg`],
      location: {
        '@type': 'Place',
        name: 'Yerevan',
        address: { '@type': 'PostalAddress', addressLocality: 'Yerevan', addressCountry: 'AM' },
        geo: { '@type': 'GeoCoordinates', ...meetingPoint },
      },
      organizer: { '@id': `${url}/#club` },
      // The club is who puts the run on. There is no separate act to name.
      performer: { '@id': `${url}/#club` },
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'AMD',
        availability: 'https://schema.org/InStock',
        url: site.whatsapp,
        // Free since the club started, and it has never been otherwise.
        validFrom: '2026-02-12T00:00:00+04:00',
      },
    }))
  ),
};
---

<script type="application/ld+json" set:html={JSON.stringify(club)} />
