---
import { runs } from '../data/site';
---

<section class="section schedule" id="schedule">
  <div class="wrap">
    <p class="eyebrow">Every week, rain or shine</p>
    <h2 class="schedule__head">
      Three runs.<br /><span class="schedule__accent">No sign-up.</span>
    </h2>

    <div class="schedule__grid">
      {
        runs.map((run, i) => (
          <article class={`run reveal run--${run.accent}`} style={`--tilt:${i % 2 ? 1 : -1}deg`}>
            <span class="run__index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <p class="run__label">
              <span aria-hidden="true">{run.icon}</span> {run.label}
            </p>
            <h3 class="run__day">{run.day}</h3>
            <p class="run__time">{run.time}</p>
            <p class="run__blurb">{run.blurb}</p>
          </article>
        ))
      }
    </div>

    <p class="schedule__note">
      <strong>Meeting points move week to week.</strong> We post them on Instagram and in the
      WhatsApp group a day or two before each run.
    </p>
  </div>
</section>

<style>
  .schedule__head {
    margin-bottom: 3.5rem;
  }

  .schedule__accent {
    color: var(--pink-text);
    -webkit-text-stroke: 1.5px var(--ink);
  }

  .schedule__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .run {
    position: relative;
    overflow: hidden;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
    padding: 1.9rem 1.75rem 2rem;
    display: flex;
    flex-direction: column;
    rotate: var(--tilt);
    transition: rotate 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }

  .run:hover {
    rotate: 0deg;
    transform: translate(-3px, -3px);
    box-shadow: 11px 11px 0 var(--ink);
  }

  .run--pink {
    background: var(--pink);
  }
  .run--sage {
    background: var(--sage);
  }

  /* A ghost numeral gives each card a bit of poster structure. */
  .run__index {
    position: absolute;
    top: -0.32em;
    right: 0.06em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 8rem;
    line-height: 1;
    letter-spacing: -0.06em;
    color: color-mix(in srgb, var(--ink) 11%, transparent);
    pointer-events: none;
  }

  .run__label {
    position: relative;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0 0 1.75rem;
  }

  .run__day {
    position: relative;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
  }

  .run__time {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3.25rem, 7vw, 4.25rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    margin: 0.5rem 0 1.25rem;
  }

  .run__blurb {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .schedule__note {
    margin: 3rem 0 0;
    max-width: 54ch;
    color: var(--ink-soft);
  }

  .schedule__note strong {
    color: var(--ink);
  }
</style>
