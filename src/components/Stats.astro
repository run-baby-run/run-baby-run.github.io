---
import { meetUps } from '../data/library';
import { stats as athletes } from '../data/stats';
import { joined, left, EARTH_CIRCUMFERENCE_KM, EVEREST_M } from '../data/club';

// Summed from the Strava figures rather than written down, so these move on
// their own whenever the numbers are next refreshed.
const total = athletes.reduce(
  (sum, a) => ({
    km: sum.km + a.allTime.distanceKm,
    metres: sum.metres + a.allTime.elevationM,
    activities: sum.activities + a.allTime.activities,
  }),
  { km: 0, metres: 0, activities: 0 }
);

const aroundTheEarth = Math.round((total.km / EARTH_CIRCUMFERENCE_KM) * 100);
const everests = Math.floor(total.metres / EVEREST_M);
const en = new Intl.NumberFormat('en-GB');

/**
 * `value` is rendered as the final number, so it is right with no JavaScript;
 * `count` is what the script counts up to when the band scrolls into view.
 */
const stats = [
  { value: en.format(Math.round(total.km)), count: Math.round(total.km), label: `km together — ${aroundTheEarth}% of the way round the Earth` },
  { value: en.format(total.metres), count: total.metres, label: `metres climbed — ${everests} times up Everest` },
  { value: en.format(total.activities), count: total.activities, label: 'runs recorded between us' },
  { value: String(meetUps), count: meetUps, label: 'times we have met' },
  { value: String(joined), count: joined, label: `people have joined — ${left} have left` },
  { value: '0', label: 'to join, forever' },
];
---

<section class="stats">
  <div class="wrap stats__inner">
    {
      stats.map((stat) => (
        <div class="stat">
          <span class="stat__value" data-count={stat.count ?? undefined}>
            {stat.value}
          </span>
          <span class="stat__label">{stat.label}</span>
        </div>
      ))
    }
  </div>
  <img class="stats__mark" src="/images/runners.png" alt="" width="449" height="397" loading="lazy" />
</section>

<script>
  // Count up once, when the band first scrolls into view. The final number is
  // already in the markup, so this only ever animates towards what is there —
  // with no JavaScript, or under reduced motion, the right figure shows anyway.
  function initCounters() {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const numbers = document.querySelectorAll<HTMLElement>('.stat__value[data-count]');
    if (!numbers.length) return;

    const en = new Intl.NumberFormat('en-GB');

    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target) || target <= 0) return;
      const started = performance.now();
      const ms = 1100;

      const step = (now: number) => {
        const t = Math.min((now - started) / ms, 1);
        // Fast at first, easing to a stop, so the last digits settle rather
        // than race past.
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = en.format(Math.round(target * eased));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const seen = new WeakSet<Element>();
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting || seen.has(entry.target)) continue;
          seen.add(entry.target);
          run(entry.target as HTMLElement);
        }
      },
      { threshold: 0.4 }
    );

    numbers.forEach((n) => io.observe(n));
  }

  initCounters();
  document.addEventListener('astro:page-load', initCounters);
</script>

<style>
  .stats {
    position: relative;
    background: var(--ink);
    color: var(--cream);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .stats__inner {
    position: relative;
    z-index: 1;
    display: grid;
    /* Wide enough for "301,015". These were sized when the biggest number here
       had two digits, and six-figure ones ran into each other. */
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 5.5vw, 3.75rem);
    /* Long numbers must never bleed into the next column. */
    max-width: 100%;
    overflow-wrap: anywhere;
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--pink);
  }

  .stat:nth-child(even) .stat__value {
    color: var(--sage);
  }

  .stat__label {
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cream) 62%, transparent);
  }

  /* The runners run off the right edge of the band. */
  .stats__mark {
    position: absolute;
    right: -2%;
    bottom: -12%;
    width: min(26vw, 320px);
    opacity: 0.09;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .stats__mark {
      display: none;
    }
  }
</style>
