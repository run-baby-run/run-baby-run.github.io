---
import { runs } from '../data/site';
import { members } from '../data/members';

const stats = [
  { value: String(runs.length), label: 'runs every week' },
  { value: `${members.length}+`, label: 'regulars on the page' },
  { value: '0', label: 'to join, forever' },
  { value: 'All', label: 'paces, one start line' },
];
---

<section class="stats">
  <div class="wrap stats__inner">
    {
      stats.map((stat) => (
        <div class="stat">
          <span class="stat__value">{stat.value}</span>
          <span class="stat__label">{stat.label}</span>
        </div>
      ))
    }
  </div>
  <img class="stats__mark" src="/images/runners.png" alt="" width="449" height="397" loading="lazy" />
</section>

<style>
  .stats {
    position: relative;
    background: var(--ink);
    color: var(--cream);
    padding-block: clamp(2.5rem, 5vw, 4rem);
    overflow: hidden;
  }

  .stats__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat__value {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 7vw, 4.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: var(--pink);
  }

  .stat:nth-child(even) .stat__value {
    color: var(--sage);
  }

  .stat__label {
    font-size: 0.8125rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cream) 62%, transparent);
  }

  /* The runners run off the right edge of the band. */
  .stats__mark {
    position: absolute;
    right: -2%;
    bottom: -12%;
    width: min(26vw, 320px);
    opacity: 0.09;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .stats__mark {
      display: none;
    }
  }
</style>
