---
/**
 * Republic Square — the Government House, reduced to what makes it
 * recognisable at a glance: the tuff arcade, the clock tower and the flag.
 *
 * We run past it at night, and that is how it is drawn: every arch and every
 * upper window lit warm from inside, which is what you actually see from the
 * road at ten o'clock. Scenery, so it sits behind the figures.
 */

const ink = '#141414';
const tuff = '#e2c39a';
const tuffDark = '#c9a578';
const cream = '#f7f6f4';
/** The floodlight the whole facade carries after dark. */
const lit = '#f6c979';
const litDeep = '#e0a248';
const glow = '#fff0cf';

/** Upper windows, in the band above the arcade. */
const windows = [
  ...[0, 1, 2, 3, 4].map((i) => 18 + i * 27),
  ...[0, 1, 2, 3, 4].map((i) => 214 + i * 27),
];

// The arcade: a run of round-headed arches either side of the tower.
const leftArches = [0, 1, 2, 3].map((i) => 16 + i * 30);
const rightArches = [0, 1, 2, 3].map((i) => 216 + i * 30);
---

<svg class="square" viewBox="0 0 350 200" role="img" aria-label="Republic Square">
  <!-- flag -->
  <path d="M175 8 L175 34" stroke={ink} stroke-width="3.5" stroke-linecap="round" />
  <path d="M175 10 L196 15 L175 20 Z" fill="#f6a8c4" stroke={ink} stroke-width="3" stroke-linejoin="round" />

  <!-- tower -->
  <path
    d="M148 34 L202 34 L202 190 L148 190 Z"
    fill={tuff}
    stroke={ink}
    stroke-width="4"
    stroke-linejoin="round"
  />
  <path d="M144 34 L206 34 L206 44 L144 44 Z" fill={tuffDark} stroke={ink} stroke-width="4" stroke-linejoin="round" />
  <!-- clock -->
  <circle cx="175" cy="66" r="15" fill={cream} stroke={ink} stroke-width="4" />
  <path d="M175 66 L175 57 M175 66 L182 70" stroke={ink} stroke-width="3" stroke-linecap="round" />
  <!-- tower arch -->
  <path d="M162 190 L162 124 Q175 110 188 124 L188 190 Z" fill={lit} stroke={ink} stroke-width="4" stroke-linejoin="round" />
  <path d="M168 190 L168 128 Q175 119 182 128 L182 190 Z" fill={litDeep} opacity="0.55" />

  <!-- wings -->
  <path d="M6 96 L148 96 L148 190 L6 190 Z" fill={tuff} stroke={ink} stroke-width="4" stroke-linejoin="round" />
  <path d="M202 96 L344 96 L344 190 L202 190 Z" fill={tuff} stroke={ink} stroke-width="4" stroke-linejoin="round" />

  <!-- arcades -->
  {
    [...leftArches, ...rightArches].map((x) => (
      <>
        <path
          d={`M${x} 186 L${x} 140 Q${x + 11} 126 ${x + 22} 140 L${x + 22} 186 Z`}
          fill={lit}
          stroke={ink}
          stroke-width="3.5"
          stroke-linejoin="round"
        />
        {/* the light falls off towards the back of each arch */}
        <path
          d={`M${x + 5} 186 L${x + 5} 143 Q${x + 11} 133 ${x + 17} 143 L${x + 17} 186 Z`}
          fill={litDeep}
          opacity="0.55"
        />
      </>
    ))
  }

  <!-- the lit windows above the arcade -->
  {
    windows.map((x) => (
      <>
        <rect x={x} y="102" width="14" height="12" rx="1.5" fill={glow} stroke={ink} stroke-width="2.4" />
        <path d={`M${x + 7} 102 L${x + 7} 114`} stroke={ink} stroke-width="1.6" opacity="0.45" />
      </>
    ))
  }

  <!-- and two in the tower -->
  <rect x="160" y="88" width="12" height="14" rx="1.5" fill={glow} stroke={ink} stroke-width="2.4" />
  <rect x="178" y="88" width="12" height="14" rx="1.5" fill={glow} stroke={ink} stroke-width="2.4" />

  <!-- Cornice and colonnade line. The cornice stops at the tower rather than
       running through it — it was crossing the two lit windows under the clock,
       and on the real building the tower breaks the line anyway. -->
  <path d="M6 96 L148 96 M202 96 L344 96" stroke={ink} stroke-width="4" stroke-linecap="round" />
  <path d="M6 118 L148 118 M202 118 L344 118" stroke={ink} stroke-width="3" stroke-linecap="round" />
</svg>

<style>
  .square {
    width: 100%;
    height: auto;
  }
</style>
