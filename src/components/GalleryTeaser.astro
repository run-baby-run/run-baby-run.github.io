---
import { photos } from '../data/library';
import { hiddenFromDiary } from '../data/hidden';
import { similarToOthers } from '../data/similar';

// The three most recent landscape frames, so the teaser row stays one clean
// height. Drawn from the same library the gallery uses, so the count on the
// button is the real one — it used to read "See all 30 photos" from a curated
// set that the gallery outgrew by a factor of thirty.
//
// Screened the same way the diary is: the first version of this picked up a
// promotional card for somebody else's race as one of its three.
const preview = photos
  .filter((p) => !p.tall && !hiddenFromDiary.has(p.id) && !similarToOthers.has(p.id))
  .slice(-3)
  .reverse();

const day = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
  });
---

<section class="section teaser" id="gallery">
  <div class="wrap">
    <div class="teaser__head">
      <div>
        <p class="eyebrow">Most weeks look like this</p>
        <h2>Every run ends<br />with a photo.</h2>
      </div>
      <p class="teaser__ctas">
        <a class="btn btn--ghost" href="/gallery/">See all {photos.length} photos →</a>
        <a class="btn teaser__film" href="/diary/#film">Watch the film →</a>
      </p>
    </div>

    <ul class="teaser__row">
      {
        preview.map((photo, i) => (
          <li class="teaser__shot" style={`--tilt:${(i % 3) - 1}deg`}>
            <a href="/gallery/" aria-label={`The gallery — ${photos.length} photos`}>
              <img
                src={`/photos/${photo.month}/${photo.id}.webp`}
                alt={`Run Baby Run, ${day(photo.date)}`}
                width={photo.width}
                height={photo.height}
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .teaser__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
  }

  .teaser__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 0;
  }

  .teaser__row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(0.75rem, 2vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .teaser__shot a {
    display: block;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--cream);
    box-shadow: var(--shadow-sm);
    transform: rotate(var(--tilt, 0deg));
    transition: transform 0.18s ease;
  }

  .teaser__shot a:hover,
  .teaser__shot a:focus-visible {
    transform: rotate(0deg) translate(-2px, -2px);
  }

  .teaser__shot img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (prefers-reduced-motion: reduce) {
    .teaser__shot a {
      transform: none;
      transition: none;
    }
  }
</style>
