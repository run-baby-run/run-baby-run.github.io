---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PersonCard from './PersonCard.astro';
import { founders, leaders } from '../data/site';
import type { Person } from '../data/site';

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/founders/*.jpg', {
  eager: true,
});

const resolve = (person: Person) => {
  const entry = portraits[`../assets/founders/${person.file}`];
  if (!entry) throw new Error(`Portrait missing: src/assets/founders/${person.file}`);
  return entry.default;
};
---

<section class="section founders" id="founders">
  <div class="wrap">
    <div class="founders__head">
      <div>
        <p class="eyebrow">Who started this</p>
        <h2>The three who showed up first.</h2>
      </div>
      <p class="founders__note">
        Shaghig, Asdghig and Jebid started with a handful of friends and a standing Tuesday
        night. It grew from there — same idea, more people.
      </p>
    </div>

    <ul class="people">
      {
        founders.map((person, i) => (
          <PersonCard person={person} image={resolve(person)} tilt={i - 1} />
        ))
      }
    </ul>

    <figure class="founders__group sticker">
      <Image
        src={import('../assets/founders/together.jpg')}
        alt="Shaghig, Asdghig and Jebid together in club shirts at a race event"
        width={1100}
        widths={[600, 1100]}
        sizes="(max-width: 1180px) 92vw, 1100px"
        loading="lazy"
        decoding="async"
      />
      <figcaption>All three, same shirt, same idea.</figcaption>
    </figure>

    <div class="leaders">
      <div class="leaders__intro">
        <h3 class="leaders__title">{leaders.length > 1 ? 'Run leaders' : 'Run leader'}</h3>
        <p class="leaders__note">
          Out front on the night, alongside the founders — setting the pace, calling the turns and
          making sure the back group never runs alone.
        </p>
      </div>
      <ul class="people people--leaders">
        {
          leaders.map((person, i) => (
            <PersonCard person={person} image={resolve(person)} tilt={i % 2 ? 1 : -1} />
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .founders__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .founders__note {
    margin: 0;
    color: var(--ink-soft);
    max-width: 42ch;
  }

  .people {
    list-style: none;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  .founders__group {
    margin: 0;
    overflow: hidden;
    rotate: -0.75deg;
  }

  .founders__group img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-bottom: var(--line) solid var(--ink);
  }

  .founders__group figcaption {
    padding: 0.8rem 1.25rem 0.95rem;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9375rem;
  }

  /* Card beside the copy, so a single leader is not stranded in white space. */
  .leaders {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: var(--line) solid var(--ink);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 300px);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }

  .leaders__title {
    margin-bottom: 0.75rem;
  }

  .leaders__note {
    color: var(--ink-soft);
    max-width: 40ch;
    margin: 0;
  }

  .people--leaders {
    margin-bottom: 0;
    grid-template-columns: 1fr;
  }

  @media (max-width: 700px) {
    .leaders {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .people--leaders {
      max-width: 280px;
    }
  }

  @media (max-width: 760px) {
    .founders__head {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
