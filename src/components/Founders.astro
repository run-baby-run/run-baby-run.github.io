---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { founders } from '../data/site';

const portraits = import.meta.glob<{ default: ImageMetadata }>('../assets/founders/*.jpg', {
  eager: true,
});

const people = founders.map((person) => {
  const entry = portraits[`../assets/founders/${person.file}`];
  if (!entry) throw new Error(`Founder portrait missing: src/assets/founders/${person.file}`);
  return { ...person, image: entry.default };
});
---

<section class="section founders" id="founders">
  <div class="wrap">
    <div class="founders__head">
      <div>
        <p class="eyebrow">Who started this</p>
        <h2>The three who showed up first.</h2>
      </div>
      <p class="founders__note">
        Shaghig, Asdghig and Jebid started with a handful of friends and a standing Tuesday
        night. It grew from there — same idea, more people.
      </p>
    </div>

    <ul class="founders__list">
      {
        people.map((person, i) => (
          <li class="founder reveal" style={`--tilt:${i - 1}deg`}>
            <figure>
              <Image
                src={person.image}
                alt={person.alt}
                width={600}
                widths={[320, 600]}
                sizes="(max-width: 700px) 88vw, 32vw"
                style={person.focus ? `object-position:${person.focus}` : undefined}
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                <span class="founder__name">{person.name}</span>
                <span class="founder__surname">{person.surname}</span>
                <span class="founder__role">{person.role}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>

    <figure class="founders__group sticker">
      <Image
        src={import('../assets/founders/together.jpg')}
        alt="Shaghig, Asdghig and Jebid together in club shirts at a race event"
        width={1100}
        widths={[600, 1100]}
        sizes="(max-width: 1180px) 92vw, 1100px"
        loading="lazy"
        decoding="async"
      />
      <figcaption>All three, same shirt, same idea.</figcaption>
    </figure>
  </div>
</section>

<style>
  .founders__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: end;
    margin-bottom: 3.5rem;
  }

  .founders__note {
    margin: 0;
    color: var(--ink-soft);
    max-width: 42ch;
  }

  .founders__list {
    list-style: none;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: clamp(1.25rem, 3vw, 2.25rem);
  }

  .founder {
    rotate: var(--tilt);
    transition: rotate 0.3s ease, transform 0.3s ease;
  }

  .founder:hover {
    rotate: 0deg;
    transform: translateY(-4px);
  }

  .founder figure {
    margin: 0;
    border: var(--line) solid var(--ink);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    background: var(--cream);
    overflow: hidden;
  }

  .founder img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-bottom: var(--line) solid var(--ink);
  }

  .founder figcaption {
    display: flex;
    flex-direction: column;
    padding: 0.9rem 1.1rem 1.1rem;
  }

  .founder__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .founder__surname {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--pink-deep);
  }

  .founder__role {
    margin-top: 0.35rem;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .founders__group {
    margin: 0;
    overflow: hidden;
    rotate: -0.75deg;
  }

  .founders__group img {
    width: 100%;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    border-bottom: var(--line) solid var(--ink);
  }

  .founders__group figcaption {
    padding: 0.8rem 1.25rem 0.95rem;
    font-family: var(--font-display);
    font-weight: 700;
    text-transform: uppercase;
    font-size: 0.9375rem;
  }

  @media (max-width: 760px) {
    .founders__head {
      grid-template-columns: 1fr;
      align-items: start;
    }
  }
</style>
